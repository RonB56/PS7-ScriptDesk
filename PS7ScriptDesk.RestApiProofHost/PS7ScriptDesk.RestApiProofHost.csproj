<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>PS7ScriptDesk.RestApiProofHost</AssemblyName>
    <RootNamespace>PS7ScriptDesk.RestApiProofHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PS7ScriptDesk.Domain\PS7ScriptDesk.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Config\TestApi.ps7api.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Scripts\TestApi.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
