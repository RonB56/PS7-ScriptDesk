<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
	<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>PS7ScriptDesk.Shell</AssemblyName>
    <RootNamespace>PS7ScriptDesk.Shell</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <InformationalVersion>3.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>PS7 ScriptDesk</AssemblyTitle>
    <Product>PS7 ScriptDesk</Product>
    <Description>An ISE-style scripting tool for PowerShell 7.x</Description>
	<ApplicationIcon>Assets\PS7ScriptDesk.Safe.ico</ApplicationIcon>
    <SelfContained Condition="'$(RuntimeIdentifier)' != '' and '$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RestApiProofHostPublishDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)\..\PS7ScriptDesk.RestApiProofHost\obj\restapi-proofhost\$(Configuration)\$(RuntimeIdentifier)\publish\</RestApiProofHostPublishDir>
    <RestApiProofHostRuntimeCatalogRoot Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)\..\PS7ScriptDesk.RestApiProofHost\obj\restapi-proofhost\$(Configuration)\catalog\</RestApiProofHostRuntimeCatalogRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="System.Management.Automation" Version="7.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="terminal\xterm.min.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="terminal\xterm.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="terminal\xterm-addon-fit.min.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="terminal\xterm-addon-web-links.min.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PS7ScriptDesk.Application\PS7ScriptDesk.Application.csproj" />
    <ProjectReference Include="..\PS7ScriptDesk.Domain\PS7ScriptDesk.Domain.csproj" />
    <ProjectReference Include="..\PS7ScriptDesk.Editor\PS7ScriptDesk.Editor.csproj" />
    <ProjectReference Include="..\PS7ScriptDesk.Infrastructure\PS7ScriptDesk.Infrastructure.csproj" />
    <ProjectReference Include="..\PS7ScriptDesk.PowerShell\PS7ScriptDesk.PowerShell.csproj" />
    <ProjectReference Include="..\PS7ScriptDesk.UI\PS7ScriptDesk.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PS7ScriptDesk.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <RestApiProofHostBundledRuntime Include="win-x64">
      <RuntimePlatformTarget>x64</RuntimePlatformTarget>
    </RestApiProofHostBundledRuntime>
    <RestApiProofHostBundledRuntime Include="win-arm64">
      <RuntimePlatformTarget>ARM64</RuntimePlatformTarget>
    </RestApiProofHostBundledRuntime>
  </ItemGroup>

  <Target Name="PublishRestApiProofHostForShell"
          BeforeTargets="CopyFilesToPublishDirectory"
          Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="..\PS7ScriptDesk.RestApiProofHost\PS7ScriptDesk.RestApiProofHost.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(RestApiProofHostPublishDir)" />
    <ItemGroup>
      <RestApiProofHostPublishedFiles Include="$(RestApiProofHostPublishDir)**\*" />
      <ResolvedFileToPublish Include="@(RestApiProofHostPublishedFiles)">
        <RelativePath>RestApi\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyRestApiProofHostToShellPublish"
          AfterTargets="Publish"
          DependsOnTargets="PublishRestApiProofHostForShell"
          Condition="'$(RuntimeIdentifier)' != '' and '$(PublishDir)' != ''">
    <ItemGroup>
      <RestApiProofHostPublishedFilesForCopy Include="$(RestApiProofHostPublishDir)**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)RestApi" />
    <Copy SourceFiles="@(RestApiProofHostPublishedFilesForCopy)"
          DestinationFiles="@(RestApiProofHostPublishedFilesForCopy->'$(PublishDir)RestApi\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishRestApiProofHostRuntimeCatalogForShell"
          BeforeTargets="CopyFilesToPublishDirectory"
          Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="..\PS7ScriptDesk.RestApiProofHost\PS7ScriptDesk.RestApiProofHost.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=%(RestApiProofHostBundledRuntime.Identity);PlatformTarget=%(RestApiProofHostBundledRuntime.RuntimePlatformTarget);SelfContained=true;PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(RestApiProofHostRuntimeCatalogRoot)%(RestApiProofHostBundledRuntime.Identity)\publish\" />
    <ItemGroup>
      <RestApiProofHostPublishedCatalogFiles Include="$(RestApiProofHostRuntimeCatalogRoot)win-x64\publish\**\*">
        <RestApiRuntimeIdentifier>win-x64</RestApiRuntimeIdentifier>
      </RestApiProofHostPublishedCatalogFiles>
      <RestApiProofHostPublishedCatalogFiles Include="$(RestApiProofHostRuntimeCatalogRoot)win-arm64\publish\**\*">
        <RestApiRuntimeIdentifier>win-arm64</RestApiRuntimeIdentifier>
      </RestApiProofHostPublishedCatalogFiles>
      <ResolvedFileToPublish Include="@(RestApiProofHostPublishedCatalogFiles)">
        <RelativePath>RestApi\%(RestApiProofHostPublishedCatalogFiles.RestApiRuntimeIdentifier)\%(RestApiProofHostPublishedCatalogFiles.RecursiveDir)%(RestApiProofHostPublishedCatalogFiles.Filename)%(RestApiProofHostPublishedCatalogFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
