<Window x:Class="PS7ScriptDesk.Shell.Help.ContextHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS7 ScriptDesk Help"
        Height="700"
        Width="860"
        MinHeight="500"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.App.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="HomeButton"
                        Content="Home"
                        Padding="12,6"
                        Click="HomeButton_Click"
                        AutomationProperties.Name="Show Help Home" />
                <Button x:Name="BackButton"
                        Content="Back"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="BackButton_Click"
                        AutomationProperties.Name="Go back in Help navigation" />
            </StackPanel>
            <TextBox x:Name="HelpSearchBox"
                     DockPanel.Dock="Right"
                     Width="280"
                     Padding="8,5"
                     VerticalContentAlignment="Center"
                     TextChanged="HelpSearchBox_TextChanged"
                     KeyDown="HelpSearchBox_KeyDown"
                     ToolTip="Search Help topics by title, key, or content"
                     AutomationProperties.Name="Search Help topics" />
            <TextBlock DockPanel.Dock="Right"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Search" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="16"
                Margin="0,0,0,12"
                Style="{StaticResource PanelCardBorderStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                    <TextBlock x:Name="TopicTitleText"
                               FontSize="{StaticResource Theme.FontSize.Heading}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Text.Primary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TopicQuickSummaryText"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Theme.Text.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Name="ContextHelpLabel"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Text="Context Help"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Text.Secondary}"
                           AutomationProperties.Name="Context Help" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BodyPanel" />
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Text.Secondary}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="RelatedTopicsButton"
                        Content="Related Topics"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="RelatedTopicsButton_Click" />
                <Button Content="Close"
                        IsDefault="True"
                        MinWidth="90"
                        Padding="12,6"
                        Click="CloseButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
