<Window x:Class="PS7ScriptDesk.Shell.Help.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PS7 ScriptDesk"
        Width="520"
        SizeToContent="Height"
        MinHeight="320"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.App.Background}"
        AutomationProperties.Name="About PS7 ScriptDesk">
    <Grid Margin="18" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="0,0,0,14"
                BorderBrush="{DynamicResource Theme.Border.Subtle}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="ProductNameText"
                           FontSize="{StaticResource Theme.FontSize.Section}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Text.Primary}"
                           AutomationProperties.Name="Product name" />
                <TextBlock x:Name="VersionText"
                           Margin="0,4,0,0"
                           FontSize="{StaticResource Theme.FontSize.Body}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Text.Secondary}"
                           AutomationProperties.Name="Running application version" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.Text.Primary}"
                   AutomationProperties.Name="Product description" />

        <TextBlock x:Name="PackageMetadataText"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.Text.Secondary}"
                   AutomationProperties.Name="Package metadata status" />

        <Button Grid.Row="3"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Content="Close"
                IsDefault="True"
                Style="{StaticResource IdeDialogPrimaryButtonStyle}"
                Click="CloseButton_Click"
                AutomationProperties.Name="Close About window" />
    </Grid>
</Window>
