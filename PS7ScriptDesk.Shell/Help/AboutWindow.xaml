<Window x:Class="PS7ScriptDesk.Shell.Help.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PS7 ScriptDesk"
        Width="520"
        SizeToContent="Height"
        MinHeight="320"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.App.Background}"
        Style="{StaticResource IdeSecondaryWindowStyle}"
        AutomationProperties.Name="About PS7 ScriptDesk">
    <Grid Margin="{StaticResource Padding.Card}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource IdeDialogFooterStyle}"
                Padding="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="ProductNameText"
                           Style="{StaticResource IdeDialogTitleStyle}"
                           AutomationProperties.Name="Product name" />
                <TextBlock x:Name="VersionText"
                           Margin="0,4,0,0"
                           FontSize="{StaticResource Theme.FontSize.Body}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Text.Secondary}"
                           AutomationProperties.Name="Running application version" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource IdeDialogDescriptionStyle}"
                   AutomationProperties.Name="Product description" />

        <TextBlock x:Name="PackageMetadataText"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource IdeDialogFieldHelpStyle}"
                   AutomationProperties.Name="Package metadata status" />

        <TextBlock x:Name="PowerShellRuntimeText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Style="{StaticResource IdeDialogFieldHelpStyle}"
                   AutomationProperties.Name="PowerShell runtime version" />

        <StackPanel Grid.Row="4" Margin="0,14,0,0" Orientation="Horizontal">
            <TextBlock Margin="0,0,16,0" VerticalAlignment="Center">
                <Hyperlink Click="RepositoryLink_Click">Project repository</Hyperlink>
            </TextBlock>
            <TextBlock VerticalAlignment="Center">
                <Hyperlink Click="IssueLink_Click">Report an issue</Hyperlink>
            </TextBlock>
        </StackPanel>

        <WrapPanel Grid.Row="5" Margin="0,14,0,0">
            <Button Margin="0,0,8,8" Content="Open Logs Folder" Click="OpenLogsButton_Click" />
            <Button Margin="0,0,8,8" Content="Create Support Package" Click="CreateSupportPackageButton_Click" />
            <Button Margin="0,0,8,8" Content="Copy Diagnostic Information" Click="CopyDiagnosticsButton_Click" />
        </WrapPanel>

        <Button Grid.Row="6"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Content="Close"
                IsDefault="True"
                Style="{StaticResource IdeDialogPrimaryButtonStyle}"
                Click="CloseButton_Click"
                AutomationProperties.Name="Close About window" />
    </Grid>
</Window>
