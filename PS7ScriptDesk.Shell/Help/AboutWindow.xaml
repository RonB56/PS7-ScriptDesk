<Window x:Class="PS7ScriptDesk.Shell.Help.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PS7 ScriptDesk"
        Width="520"
        SizeToContent="Height"
        MinHeight="320"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.App.Background}"
        AutomationProperties.Name="About PS7 ScriptDesk">
    <Grid Margin="20" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18"
                Style="{StaticResource PanelCardBorderStyle}">
            <StackPanel>
                <TextBlock x:Name="ProductNameText"
                           FontSize="{StaticResource Theme.FontSize.Heading}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Text.Primary}"
                           AutomationProperties.Name="Product name" />
                <TextBlock x:Name="VersionText"
                           Margin="0,8,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Accent.Primary}"
                           AutomationProperties.Name="Running application version" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="DescriptionText"
                   Grid.Row="1"
                   Margin="4,18,4,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.Text.Primary}"
                   AutomationProperties.Name="Product description" />

        <TextBlock x:Name="PackageMetadataText"
                   Grid.Row="2"
                   Margin="4,14,4,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.Text.Secondary}"
                   AutomationProperties.Name="Package metadata status" />

        <Button Grid.Row="3"
                Margin="0,24,0,0"
                Width="96"
                HorizontalAlignment="Right"
                Padding="12,6"
                Content="Close"
                IsDefault="True"
                Click="CloseButton_Click"
                AutomationProperties.Name="Close About window" />
    </Grid>
</Window>
