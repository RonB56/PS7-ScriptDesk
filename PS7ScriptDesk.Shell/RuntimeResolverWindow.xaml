<Window x:Class="PS7ScriptDesk.Shell.RuntimeResolverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        Title="PowerShell 7 Required"
        Width="620"
        Height="600"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.App.Background}"
        Style="{DynamicResource IdeSecondaryWindowStyle}"
        help:ContextHelp.Key="Runtime.Resolver"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource Padding.Card}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PS7 ScriptDesk requires PowerShell 7.0 or newer."
                   Style="{DynamicResource IdeDialogTitleStyle}"
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Style="{DynamicResource IdeDialogPanelStyle}">
            <TextBlock TextWrapping="Wrap" LineHeight="20">
                PowerShell 7 was not found automatically. Windows PowerShell 5.1 is not supported for this version of PS7 ScriptDesk.
                <LineBreak />
                <LineBreak />
                Click <Run FontWeight="SemiBold">Try Automatic Search Again</Run>, browse directly to <Run FontFamily="Consolas">pwsh.exe</Run>, or install PowerShell 7 from Microsoft and restart the app.
                <LineBreak />
                <LineBreak />
                Common install location: <Run FontFamily="Consolas">C:\Program Files\PowerShell\7\pwsh.exe</Run>
                <LineBreak />
                Microsoft Store alias location: <Run FontFamily="Consolas">%LOCALAPPDATA%\Microsoft\WindowsApps\pwsh.exe</Run>
            </TextBlock>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,16,0,6"
                   Text="Selected runtime path"
                   Style="{DynamicResource IdeDialogFieldLabelStyle}"
                   AutomationProperties.Name="Selected runtime path label" />

        <DockPanel Grid.Row="3"
                   LastChildFill="True">
            <Button Content="Browse..."
                    Width="104"
                    Margin="10,0,0,0"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    Click="BrowseButton_Click"
                    help:ContextHelp.Key="Runtime.Resolver"
                    DockPanel.Dock="Right" />
            <TextBox x:Name="SelectedPathTextBox"
                     IsReadOnly="True"
                     Padding="8,5"
                     AutomationProperties.Name="Selected runtime path"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="4"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{DynamicResource IdeDialogPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Status" Style="{DynamicResource IdeDialogFieldLabelStyle}" />
                        <TextBlock x:Name="StatusMessageTextBlock"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   AutomationProperties.Name="Runtime resolver status"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Expander Header="More Info"
                          Margin="0,14,0,0"
                          IsExpanded="True">
                    <Border Margin="0,8,0,0"
                            Style="{DynamicResource IdeDialogPanelStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Secondary}">
                                PS7 ScriptDesk requires PowerShell 7.x or newer. Windows PowerShell 5.1 is a different product and is not supported for normal startup.
                            </TextBlock>
                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Secondary}">
                                Look for <Run FontFamily="Consolas">pwsh.exe</Run>, not <Run FontFamily="Consolas">powershell.exe</Run>.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Theme.Text.Secondary}">
                                If this window appears even though PowerShell 7 is installed, click <Run FontWeight="SemiBold">Open Logs Folder</Run> and include the startup/runtime logs in your support report.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="5"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Right">
            <Button Content="Try Automatic Search Again"
                    Margin="0,0,7,7"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Try automatic runtime search again"
                    Click="RetryDiscoveryButton_Click"
                    help:ContextHelp.Key="Runtime.Refresh" />
            <Button Content="Browse for pwsh.exe"
                    Margin="0,0,7,7"
                    IsDefault="True"
                    Style="{DynamicResource IdeDialogPrimaryButtonStyle}"
                    AutomationProperties.Name="Browse for PowerShell executable"
                    Click="BrowseButton_Click"
                    help:ContextHelp.Key="Runtime.Resolver" />
            <Button Content="Open Logs Folder"
                    Margin="0,0,7,7"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Open runtime logs folder"
                    Click="OpenLogsFolderButton_Click"
                    help:ContextHelp.Key="Help.Logs" />
            <Button Content="Copy Logs Path"
                    Margin="0,0,7,7"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Copy runtime logs path"
                    Click="CopyLogsPathButton_Click"
                    help:ContextHelp.Key="Help.Logs" />
            <Button Content="Exit"
                    Margin="0,0,7,0"
                    IsCancel="True"
                    Style="{DynamicResource IdeDialogTertiaryButtonStyle}"
                    AutomationProperties.Name="Exit runtime resolver"
                    Click="ExitButton_Click"
                    help:ContextHelp.Key="Runtime.Resolver" />
            <Button Content="Copy Setup Help Text"
                    Margin="0"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Copy setup help text"
                    Click="CopyHelpTextButton_Click"
                    help:ContextHelp.Key="Runtime.Resolver" />
        </WrapPanel>
    </Grid>
</Window>
