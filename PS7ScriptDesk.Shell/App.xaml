                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Theme.Surface.Secondary}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Theme.Border.Subtle}" />
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IdeToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource IdeToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface.Secondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Subtle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="IdeToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IdeToolbarButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <Style x:Key="IdeToolbarSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="7,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Width="1"
                                Background="{DynamicResource Theme.Border.Strong}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IdeSplitterGripStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}">
                            <Border x:Name="GripLine"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Theme.Border.Subtle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Surface.Hover}" />
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IdeColumnSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource IdeSplitterGripStyle}">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}">
                            <Border x:Name="GripLine"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    Margin="0,8"
                                    Background="{DynamicResource Theme.Border.Subtle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Surface.Hover}" />
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IdeRowSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource IdeSplitterGripStyle}">
            <Setter Property="Height" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}">
                            <Border x:Name="GripLine"
                                    Height="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Margin="8,0"
                                    Background="{DynamicResource Theme.Border.Subtle}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Surface.Hover}" />
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="GripLine" Property="Background" Value="{DynamicResource Theme.Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface.Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Strong}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="1,0" />
        </Style>

        <Style x:Key="IdeStatusBarSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="2,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Width="1"
                                Background="{DynamicResource Theme.Border.Subtle}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface.Secondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Small}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Theme.Selection.Background}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Theme.Surface.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="IdeTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Theme.Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Border x:Name="SelectionUnderline"
                                        Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="Transparent" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.Surface.Primary}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent.Primary}" />
                                <Setter TargetName="SelectionUnderline" Property="Background" Value="{DynamicResource Theme.Accent.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.Surface.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IdeCompactEditorTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource IdeTabItemStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource Theme.Surface.Secondary}"
                                BorderBrush="{DynamicResource Theme.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Small}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.Surface.Primary}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Theme.Accent.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Theme.Surface.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface.Secondary}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Subtle}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Theme.Surface.Tertiary}" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Theme.Surface.Tertiary}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
        </Style>

        <Style x:Key="IdeToolWindowDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="ColumnHeaderHeight" Value="26" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Theme.Border.Subtle}" />
        </Style>

        <Style x:Key="IdeToolWindowListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="IdeEmptyPaneTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Theme.FontSize.Caption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="ContextHelpToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Theme.ToolTip.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.ToolTip.Foreground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.ToolTip.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ToolTip.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Width="6"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Theme.Accent.Primary}" />
                                <ContentPresenter Margin="16,12,12,12" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
