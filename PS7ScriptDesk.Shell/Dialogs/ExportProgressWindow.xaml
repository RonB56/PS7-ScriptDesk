<Window x:Class="PS7ScriptDesk.Shell.Dialogs.ExportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        Title="Export as EXE"
        Width="640"
        MinHeight="380"
        SizeToContent="Height"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.App.Background}"
        help:ContextHelp.Key="Command.ExportAsExe"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ExportWizardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Export as EXE"
                   FontSize="{StaticResource Theme.FontSize.Heading}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Theme.Text.Primary}"
                   AutomationProperties.Name="Export as EXE progress" />

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource WizardSectionCardStyle}">
        <StackPanel>
            <TextBlock x:Name="OutputFileNameText"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Text.Primary}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="OutputPathText"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Theme.Text.Secondary}"
                       TextWrapping="Wrap" />
        </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource WizardSectionCardStyle}">
        <StackPanel>
            <TextBlock x:Name="StageText"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Text.Primary}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText"
                       Margin="0,4,0,8"
                       Foreground="{DynamicResource Theme.Text.Secondary}"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="ExportProgressBar"
                         Height="16"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="True"
                         help:ContextHelp.Key="Command.ExportAsExe"
                         AutomationProperties.Name="Export progress" />
        </StackPanel>
        </Border>

        <Border Grid.Row="3"
                x:Name="CompletionBorder"
                Margin="0,16,0,0"
                Visibility="Collapsed"
                Style="{StaticResource WizardSectionCardStyle}">
            <TextBlock x:Name="CompletionText"
                       Foreground="{DynamicResource Theme.Text.Primary}"
                       TextWrapping="Wrap" />
        </Border>

        <Expander Grid.Row="4"
                  x:Name="DetailsExpander"
                  Margin="0,14,0,0"
                  Header="Details"
                  Visibility="Collapsed">
            <TextBox x:Name="DetailsTextBox"
                     MinHeight="96"
                     MaxHeight="220"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     help:ContextHelp.Key="Command.ExportAsExe"
                     AutomationProperties.Name="Export details" />
        </Expander>

        <StackPanel Grid.Row="5"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="OpenFolderButton"
                    Content="Open Folder"
                    Margin="0,0,8,0"
                    Style="{StaticResource WizardSecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="OpenFolderButton_Click"
                    help:ContextHelp.Key="Command.ExportAsExe"
                    AutomationProperties.Name="Open exported executable folder" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    Style="{StaticResource WizardPrimaryButtonStyle}"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="CloseButton_Click"
                    help:ContextHelp.Key="Command.ExportAsExe"
                    AutomationProperties.Name="Close export progress" />
        </StackPanel>
    </Grid>
</Window>
