<Window x:Class="PS7ScriptDesk.Shell.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter value"
        Width="440"
        SizeToContent="Height"
        MinWidth="360"
        MaxWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{DynamicResource IdeSecondaryWindowStyle}"
        AutomationProperties.Name="Text input dialog"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="{DynamicResource Padding.Card}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                   Style="{DynamicResource IdeDialogTitleStyle}"
                   AutomationProperties.Name="Input dialog title" />
        <TextBlock Grid.Row="1" Margin="0,6,0,12"
                   Text="{Binding Prompt, RelativeSource={RelativeSource AncestorType=Window}}"
                   Style="{DynamicResource IdeDialogDescriptionStyle}"
                   AutomationProperties.Name="Input dialog prompt" />
        <StackPanel Grid.Row="2">
            <TextBox x:Name="InputBox"
                     Text="{Binding InputText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Input value"
                     AutomationProperties.HelpText="Enter a value, then choose OK or press Enter"
                     Margin="0,0,0,12"
                     KeyDown="InputBox_KeyDown" />
            <Border Style="{DynamicResource IdeDialogFooterStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" IsDefault="True" IsEnabled="{Binding IsInputValid, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{DynamicResource IdeDialogPrimaryButtonStyle}" AutomationProperties.Name="Accept input" Click="OkButton_Click" />
                    <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0"
                            Style="{DynamicResource IdeDialogTertiaryButtonStyle}" AutomationProperties.Name="Cancel input" Click="CancelButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
