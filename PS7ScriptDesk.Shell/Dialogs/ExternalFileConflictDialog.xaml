<Window x:Class="PS7ScriptDesk.Shell.Dialogs.ExternalFileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        Title="File Changed Outside PS7 ScriptDesk"
        Width="640"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.App.Background}"
        Foreground="{DynamicResource Theme.Text.Primary}"
        Style="{DynamicResource IdeSecondaryWindowStyle}"
        help:ContextHelp.Key="Files.ExternalChanges"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="{DynamicResource Padding.Card}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{DynamicResource IdeDialogTitleStyle}"
                   Text="This script changed outside PS7 ScriptDesk."
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock TextWrapping="Wrap"
                       Style="{DynamicResource IdeDialogDescriptionStyle}"
                       Text="Saving normally would overwrite the version currently on disk." />
            <Border Style="{DynamicResource IdeDialogResultPanelStyle}" Margin="0,10,0,0">
              <StackPanel>
            <TextBlock x:Name="FilePathText"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Affected file path" />
            <TextBlock x:Name="ConflictReasonText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
              </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{DynamicResource IdeDialogFooterStyle}">
          <UniformGrid Rows="1" Columns="4">
            <Button Content="Reload from Disk"
                    Margin="0,0,6,0"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Reload file from disk"
                    Click="ReloadButton_Click"
                    ToolTip="Discard the editor changes and load the current file from disk."
                    help:ContextHelp.Key="Files.ExternalChanges" />
            <Button Content="Overwrite Disk"
                    Margin="2,0,4,0"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Overwrite disk file"
                    Click="OverwriteButton_Click"
                    ToolTip="Replace the current disk version with the editor content."
                    help:ContextHelp.Key="Files.ExternalChanges" />
            <Button Content="Save As..."
                    Margin="4,0,2,0"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Save file as another path"
                    Click="SaveAsButton_Click"
                    ToolTip="Keep the changed disk file and save the editor content to another path."
                    help:ContextHelp.Key="Files.ExternalChanges" />
            <Button Content="Cancel"
                    Margin="6,0,0,0"
                    IsDefault="True"
                    IsCancel="True"
                    Style="{DynamicResource IdeDialogPrimaryButtonStyle}"
                    AutomationProperties.Name="Cancel external file change"
                    Click="CancelButton_Click"
                    help:ContextHelp.Key="Files.ExternalChanges" />
          </UniformGrid>
        </Border>
    </Grid>
</Window>
