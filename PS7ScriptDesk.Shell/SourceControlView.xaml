<UserControl x:Class="PS7ScriptDesk.Shell.SourceControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
             help:ContextHelp.Key="Git.ViewSourceControl">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SourceControl.RepositoryText}"
                           Style="{StaticResource IdeToolWindowMetaTextStyle}"
                           FontWeight="SemiBold"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SourceControl.RepositoryText}" />
                <Button Content="{Binding SourceControl.BranchText}"
                        Style="{StaticResource IdeSecondaryButtonStyle}"
                        Margin="12,0,0,0"
                        Padding="4,1"
                        Click="BranchButton_Click"
                        AutomationProperties.Name="Current Git branch"
                        ToolTip="Switch, create, rename, or delete local branches." />
                <TextBlock Text="{Binding SourceControl.ChangeSummaryText}"
                           Style="{StaticResource IdeToolWindowMetaTextStyle}"
                           Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PopOutButton"
                        Content="Pop Out"
                        Style="{StaticResource IdeSecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        ToolTip="Pop out Source Control into a separate window."
                        Click="PopOutButton_Click" />
                <Button Content="Refresh"
                        Command="{Binding RefreshGitStatusCommand}"
                        Style="{StaticResource IdeSecondaryButtonStyle}"
                        ToolTip="Refresh read-only Git status." />
                <Button Content="Sync"
                        Command="{Binding SyncCommand}"
                        Style="{StaticResource IdeSecondaryButtonStyle}"
                        Margin="6,0,0,0"
                        ToolTip="{Binding SyncDisabledReason}"
                        AutomationProperties.Name="Sync Git repository">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Fetch" Command="{Binding FetchCommand}" />
                            <MenuItem Header="Pull" Command="{Binding PullCommand}" />
                            <MenuItem Header="Push" Command="{Binding PushCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SourceControl.FilterText, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="24"
                     Padding="6,1"
                     ToolTip="Filter by file name or relative path. Git is not rerun while filtering." />
            <ComboBox Grid.Column="1"
                      Margin="6,0,0,0"
                      MinWidth="112"
                      ItemsSource="{Binding SourceControl.ScopeOptions}"
                      SelectedItem="{Binding SourceControl.ScopeSelection, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Choose repository, current workspace folder, or current file scope." />
            <ComboBox Grid.Column="2"
                      Margin="6,0,0,0"
                      MinWidth="100"
                      ItemsSource="{Binding SourceControl.StatusFilters}"
                      SelectedItem="{Binding SourceControl.StatusFilter, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Filter changes by status." />
        </Grid>

        <Grid Grid.Row="2">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SourceControl.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,4">
                            <Expander.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Unstage All"
                                            Tag="{Binding Title}" Margin="8,0,0,0"
                                            Click="SourceControlGroupAction_Click"
                                            ToolTip="Unstage all staged changes.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IdeSecondaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Title}" Value="STAGED CHANGES">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button DockPanel.Dock="Right" Content="Stage All"
                                            Tag="{Binding Title}" Margin="8,0,0,0"
                                            Click="SourceControlGroupAction_Click"
                                            ToolTip="Stage all repository changes.">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IdeSecondaryButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Title}" Value="CHANGES">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Title}" Value="UNTRACKED">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DockPanel>
                            </Expander.Header>
                            <ListBox ItemsSource="{Binding Items}"
                                     MaxHeight="220"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemContainerStyle="{StaticResource IdeToolWindowListBoxItemStyle}"
                                     MouseDoubleClick="SourceControlFile_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding FullPath}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open" Click="SourceControlOpen_Click" ToolTip="Open only this repository file." />
                                                    <MenuItem Header="Open Diff" Click="SourceControlOpenDiff_Click" ToolTip="Review this change in a read-only editor diff." />
                                                    <Separator />
                                                    <MenuItem Header="Stage" Click="SourceControlStage_Click" ToolTip="Stage this file in the Git index." />
                                                    <MenuItem Header="Unstage" Click="SourceControlUnstage_Click" ToolTip="Remove this file from the Git index without changing its working-tree contents." />
                                                    <MenuItem Header="Discard" Click="SourceControlDiscard_Click" ToolTip="Discard saved working-tree changes after confirmation; unavailable for untracked files or dirty open documents." />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StatusGlyph}"
                                                       Foreground="{DynamicResource Theme.Accent.Primary}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding RelativePath}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="+"
                                                        Click="SourceControlStage_Click"
                                                        ToolTip="Stage this change"
                                                        AutomationProperties.Name="Stage this change"
                                                        Width="24" Height="24" Padding="0" Margin="6,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IdeSecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Expander}}" Value="STAGED CHANGES">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Expander}}" Value="CONFLICTS">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="-"
                                                        Click="SourceControlUnstage_Click"
                                                        ToolTip="Unstage this change"
                                                        AutomationProperties.Name="Unstage this change"
                                                        Width="24" Height="24" Padding="0" Margin="6,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IdeSecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=Expander}}" Value="STAGED CHANGES">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="1" Margin="0,6,0,0" Padding="6" BorderBrush="{DynamicResource Theme.Border.Subtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="42" MaxHeight="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" AutomationProperties.Name="Commit message" ToolTip="Enter a commit message. Ctrl+Enter commits staged changes; Enter inserts a new line." KeyDown="CommitMessage_KeyDown" />
                <Button Grid.Column="1" Content="Commit" Command="{Binding CommitCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource IdeSecondaryButtonStyle}" AutomationProperties.Name="Commit staged changes" ToolTip="{Binding CommitDisabledReason}" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
