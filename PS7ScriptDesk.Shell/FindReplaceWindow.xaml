<Window x:Class="PS7ScriptDesk.Shell.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        Title="Find / Replace"
        Width="760"
        Height="500"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.App.Background}"
        Foreground="{DynamicResource Theme.Text.Primary}"
        Style="{StaticResource IdeSecondaryWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown"
        help:ContextHelp.Key="FindReplace.Dialog">
    <Grid Margin="{StaticResource Padding.Card}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Find and replace" Style="{StaticResource IdeDialogTitleStyle}" />
            <TextBlock Text="Search the active script, review every match, and jump directly to a result."
                       Style="{StaticResource IdeDialogDescriptionStyle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="152" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,10,10"
                           VerticalAlignment="Center"
                           Text="Find:"
                           Style="{StaticResource IdeDialogFieldLabelStyle}"
                           AutomationProperties.Name="Find field label"
                           help:ContextHelp.Key="FindReplace.FindText" />
                <TextBox x:Name="FindTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,0,10"
                         AutomationProperties.Name="Find text"
                         AutomationProperties.HelpText="Text to find in the active script"
                         TextChanged="FindTextBox_TextChanged"
                         help:ContextHelp.Key="FindReplace.FindText" />

                <TextBlock x:Name="ReplaceLabel"
                           Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,10,10"
                           VerticalAlignment="Center"
                           Text="Replace:"
                           Style="{StaticResource IdeDialogFieldLabelStyle}"
                           AutomationProperties.Name="Replace field label"
                           help:ContextHelp.Key="FindReplace.ReplaceText" />
                <TextBox x:Name="ReplaceTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,0,10"
                         AutomationProperties.Name="Replace text"
                         AutomationProperties.HelpText="Replacement text for the active script"
                         help:ContextHelp.Key="FindReplace.ReplaceText" />

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <CheckBox x:Name="MatchCaseCheckBox"
                              Margin="0,0,18,0"
                              VerticalAlignment="Center"
                              Content="Match _case"
                              AutomationProperties.Name="Match case"
                              Checked="SearchOption_Changed"
                              Unchecked="SearchOption_Changed"
                              help:ContextHelp.Key="FindReplace.MatchCase" />
                    <CheckBox x:Name="WholeWordCheckBox"
                              Margin="0,0,18,0"
                              VerticalAlignment="Center"
                              Content="_Whole word"
                              AutomationProperties.Name="Whole word"
                              ToolTip="Match only complete words"
                              Checked="SearchOption_Changed"
                              Unchecked="SearchOption_Changed"
                              help:ContextHelp.Key="FindReplace.WholeWord" />
                    <CheckBox x:Name="UseRegexCheckBox"
                              VerticalAlignment="Center"
                              Content="Use regular _expression"
                              AutomationProperties.Name="Use regular expression"
                              ToolTip="Allows pattern-based searching. Examples: \d+ finds numbers; \$\w+ finds PowerShell variables."
                              Checked="SearchOption_Changed"
                              Unchecked="SearchOption_Changed"
                              help:ContextHelp.Key="FindReplace.Regex" />
                </StackPanel>

                <Border Grid.Row="3"
                        Style="{StaticResource IdeDialogResultPanelStyle}"
                        Grid.ColumnSpan="2"
                        AutomationProperties.Name="Find result summary">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="CountText"
                                   DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Text="0 matches"
                                   AutomationProperties.Name="Find result count"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Select a result to jump to it; double-click or press Enter to jump again."
                                   Margin="16,0,0,0"
                                   Foreground="{DynamicResource Theme.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="4" Grid.ColumnSpan="2">
                    <ListBox x:Name="ResultsListBox"
                             MouseDoubleClick="ResultsListBox_MouseDoubleClick"
                             KeyDown="ResultsListBox_KeyDown"
                             SelectionChanged="ResultsListBox_SelectionChanged"
                             AutomationProperties.Name="Find results"
                             AutomationProperties.HelpText="Select a result to navigate to its location"
                             help:ContextHelp.Key="FindReplace.FindNext">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Location}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Theme.Text.Primary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Preview}"
                                               Foreground="{DynamicResource Theme.Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ResultsEmptyText"
                               Text="Type search text to see matching lines here."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.Text.Secondary}"
                               IsHitTestVisible="False"
                               AutomationProperties.Name="Find results empty state" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Button Content="Find _Next"
                        Margin="0,0,0,8"
                        Style="{StaticResource IdeDialogPrimaryButtonStyle}"
                        IsDefault="True"
                        AutomationProperties.Name="Find next"
                        Click="FindNext_Click"
                        ToolTip="Find Next (F3)"
                        help:ContextHelp.Key="FindReplace.FindNext" />
                <Button Content="Find _Previous"
                        Margin="0,0,0,8"
                        Style="{StaticResource IdeDialogSecondaryButtonStyle}"
                        AutomationProperties.Name="Find previous"
                        Click="FindPrev_Click"
                        ToolTip="Find Previous (Shift+F3)"
                        help:ContextHelp.Key="FindReplace.FindNext" />
                <Button Content="_Replace"
                        Margin="0,0,0,8"
                        Style="{StaticResource IdeDialogSecondaryButtonStyle}"
                        AutomationProperties.Name="Replace one"
                        Click="Replace_Click"
                        help:ContextHelp.Key="FindReplace.ReplaceOne" />
                <Button Content="Replace _All"
                        Margin="0,0,0,8"
                        Style="{StaticResource IdeDialogSecondaryButtonStyle}"
                        AutomationProperties.Name="Replace all"
                        Click="ReplaceAll_Click"
                        help:ContextHelp.Key="FindReplace.ReplaceAll" />
                <Button Content="Close"
                        Margin="0,10,0,0"
                        Style="{StaticResource IdeDialogTertiaryButtonStyle}"
                        AutomationProperties.Name="Close Find and Replace"
                        Click="Close_Click"
                        help:ContextHelp.Key="FindReplace.Dialog" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource Theme.Status.Error.Foreground}"
                   Text=""
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Find and replace status"
                   AutomationProperties.LiveSetting="Polite"
                   help:ContextHelp.Key="FindReplace.Dialog" />
    </Grid>
</Window>
