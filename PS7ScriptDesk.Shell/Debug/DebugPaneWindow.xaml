<Window x:Class="PS7ScriptDesk.Shell.Debug.DebugPaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        Title="Debug Pane"
        Width="420"
        Height="480"
        MinWidth="320"
        MinHeight="260"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.App.Background}"
        Foreground="{DynamicResource Theme.Text.Primary}"
        Style="{DynamicResource IdeToolWindowStyle}"
        AutomationProperties.Name="Floating Debug Pane"
        help:ContextHelp.Key="Debug.Area"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="{DynamicResource Padding.SubtleCard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource IdeToolWindowHeaderStyle}">
          <DockPanel>
            <TextBlock Text="Debug"
                       Style="{DynamicResource IdeToolWindowHeaderTextStyle}"
                       AutomationProperties.Name="Debug pane title"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="Dock Back"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    AutomationProperties.Name="Dock debug pane back"
                    Click="DockBackButton_Click"
                    help:ContextHelp.Key="Debug.Area" />
            <Border x:Name="DebugStaleIndicator"
                    DockPanel.Dock="Left"
                    Visibility="Collapsed"
                    Margin="10,0,0,0"
                    Padding="7,2"
                    Background="{DynamicResource Theme.Status.Warning.Background}"
                    BorderBrush="{DynamicResource Theme.Status.Warning.Border}"
                    BorderThickness="1"
                    CornerRadius="3"
                    ToolTip="One or more source files changed after debugging started. The debugger is using an older source snapshot. Restart debugging to restore accurate source navigation."
                    AutomationProperties.Name="Debug Stale">
                <TextBlock Text="⚠ Debug Stale"
                           Foreground="{DynamicResource Theme.Status.Warning.Foreground}"
                           FontWeight="SemiBold" />
            </Border>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource IdeToolWindowContentBorderStyle}">
          <TabControl x:Name="DebugTabControl"
                      ItemContainerStyle="{DynamicResource IdeDebuggerTabItemStyle}"
                      SelectionChanged="DebugTabControl_SelectionChanged"
                      AutomationProperties.Name="Debugger tool content">
            <TabItem Header="Variables"
                     ToolTip="Show read-only variables for the selected paused execution frame."
                     help:ContextHelp.Key="Debug.Variables">
                <Grid>
                    <TextBlock x:Name="DebugVariablesContextText"
                               Text="Variables: no active frame"
                       Style="{DynamicResource IdeEmptyPaneContextTextStyle}"
                               Margin="4,2,4,0"
                       />
                    <DataGrid x:Name="DebugVariablesGrid"
                          Margin="0,24,0,0"
                          Style="{DynamicResource IdeDebuggerDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          FontFamily="Consolas"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="80" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                    </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="DebugVariablesEmptyStateText"
                               Text="No variables available."
                               Margin="8,36,8,8"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IdeEmptyPaneTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=DebugVariablesGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Call Stack"
                     ToolTip="Show the active call stack and navigate to available source frames."
                     help:ContextHelp.Key="Debug.CallStack">
                <DataGrid x:Name="DebugCallStackGrid"
                          Style="{DynamicResource IdeDebuggerDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionChanged="DebugCallStackGrid_SelectionChanged"
                          GridLinesVisibility="Horizontal"
                          FontFamily="Consolas"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Current" Binding="{Binding IsCurrentFrame}" Width="52" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelectedInspectionFrame}" Width="60" IsReadOnly="True" />
                        <DataGridTextColumn Header="Function" Binding="{Binding FunctionName}" Width="100" />
                        <DataGridTextColumn Header="Script" Binding="{Binding DisplayScriptName}" Width="*" />
                        <DataGridTextColumn Header="Line" Binding="{Binding DisplayLineNumber}" Width="175" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Breakpoints"
                     help:ContextHelp.Key="Debug.Breakpoints">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DebugBreakpointsGrid"
                              Grid.Row="0"
                              Style="{DynamicResource IdeDebuggerDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              FontFamily="Consolas"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="30" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="45" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1"
                            Content="Remove Selected"
                            Margin="0,6,0,0"
                            Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Click="RemoveSelectedBreakpointButton_Click"
                            help:ContextHelp.Key="Debug.RemoveBreakpoint" />
                </Grid>
            </TabItem>
          </TabControl>
        </Border>
    </Grid>
</Window>
