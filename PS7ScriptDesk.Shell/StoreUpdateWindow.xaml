<Window x:Class="PS7ScriptDesk.Shell.StoreUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        Title="PS7 ScriptDesk Update"
        Width="700"
        Height="480"
        MinWidth="680"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Theme.App.Background}"
        help:ContextHelp.Key="App.StoreUpdate"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Style="{DynamicResource IdeDialogPanelStyle}">
            <TextBlock x:Name="MessageTextBlock"
                       TextWrapping="Wrap"
                       LineHeight="20" />
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{DynamicResource IdeDialogPanelStyle}">
                    <StackPanel>
                        <TextBlock x:Name="UpdatesHeadingTextBlock"
                                   Text="Updates detected"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="UpdatesItemsControl"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Style="{DynamicResource IdeDialogPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusMessageTextBlock"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="3"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Right">
            <Button x:Name="InstallNowButton"
                    Content="Install Update Now"
                    Margin="0,0,7,7"
                    Style="{DynamicResource IdeDialogPrimaryButtonStyle}"
                    Click="InstallNowButton_Click"
                    help:ContextHelp.Key="App.StoreUpdate" />
            <Button Content="Open Microsoft Store / manual instructions"
                    Margin="0,0,7,7"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    Click="OpenStoreButton_Click"
                    help:ContextHelp.Key="App.StoreUpdate" />
            <Button Content="Open Logs Folder"
                    Margin="0,0,7,7"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    Click="OpenLogsFolderButton_Click"
                    help:ContextHelp.Key="Help.Logs" />
            <Button Content="Copy Logs Path"
                    Margin="0,0,7,7"
                    Style="{DynamicResource IdeDialogSecondaryButtonStyle}"
                    Click="CopyLogsPathButton_Click"
                    help:ContextHelp.Key="Help.Logs" />
            <Button x:Name="CloseOrExitButton"
                    Margin="0"
                    Style="{DynamicResource IdeDialogTertiaryButtonStyle}"
                    Click="CloseOrExitButton_Click"
                    help:ContextHelp.Key="App.StoreUpdate" />
        </WrapPanel>
    </Grid>
</Window>
