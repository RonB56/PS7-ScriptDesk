<UserControl x:Class="PS7ScriptDesk.Shell.Controls.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Interactive PowerShell terminal"
             AutomationProperties.HelpText="Interactive PowerShell terminal. Ctrl+Shift+F6 moves focus back to the editor."
             Focusable="True"
             KeyboardNavigation.TabNavigation="Once"
             KeyboardNavigation.ControlTabNavigation="Once">
    <Grid x:Name="WebViewHost">
        <!-- The WebView2 child is created and retired dynamically in code-behind. -->
        <Border x:Name="FallbackBanner"
                Visibility="Collapsed"
                Background="#1e1e1e"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="24,16"
                CornerRadius="6"
                AutomationProperties.Name="Terminal unavailable">
            <StackPanel>
                <TextBlock x:Name="FallbackMessageText"
                           Text="The integrated terminal renderer is unavailable. Use Reset Console to retry."
                           Foreground="#cccccc"
                           FontFamily="Consolas"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="FallbackDetailsText"
                           Text="Install it from: https://developer.microsoft.com/en-us/microsoft-edge/webview2/"
                           Foreground="#4ec9b0"
                           FontFamily="Consolas"
                           FontSize="12"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
