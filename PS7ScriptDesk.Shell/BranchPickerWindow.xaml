<Window x:Class="PS7ScriptDesk.Shell.BranchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Branch Manager" Width="620" Height="540" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Theme.App.Background}"
        Foreground="{DynamicResource Theme.Text.Primary}"
        Style="{DynamicResource IdeToolWindowStyle}">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Margin="0,0,0,8" Padding="6" AutomationProperties.Name="Search branches" ToolTip="Filter local and remote branches." />
        <ListBox x:Name="BranchList" Grid.Row="1" SelectionChanged="BranchList_SelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource IdeToolWindowListBoxItemStyle}" AutomationProperties.Name="Branches">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding TrackingText}" Margin="12,0,0,0" Foreground="{DynamicResource Theme.Text.Secondary}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
            <Button Content="Create &amp; Switch" Click="CreateSwitch_Click" Style="{DynamicResource IdePrimaryButtonStyle}" Margin="0,0,8,0" ToolTip="Create a local branch from the current HEAD and switch to it." />
            <Button Content="Create Only" Click="CreateOnly_Click" Style="{DynamicResource IdeSecondaryButtonStyle}" Margin="0,0,8,0" ToolTip="Create a local branch without switching." />
            <Button x:Name="RenameButton" Content="Rename" Click="Rename_Click" Style="{DynamicResource IdeSecondaryButtonStyle}" Margin="0,0,8,0" ToolTip="Rename the selected local branch." />
            <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" Style="{DynamicResource IdeDestructiveButtonStyle}" Margin="0,0,8,0" ToolTip="Safely delete the selected non-current local branch." ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="PublishButton" Content="Publish" Click="Publish_Click" Style="{DynamicResource IdeSecondaryButtonStyle}" ToolTip="Publish the selected current branch to the configured remote." ToolTipService.ShowOnDisabled="True" />
        </WrapPanel>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="ActionStatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{DynamicResource IdeToolWindowMetaTextStyle}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SwitchButton" Content="Switch" Click="Switch_Click" IsDefault="True" Style="{DynamicResource IdePrimaryButtonStyle}" Margin="0,0,8,0" ToolTip="Switch to the selected different local branch." ToolTipService.ShowOnDisabled="True" />
                <Button Content="Close" Click="Close_Click" IsCancel="True" Style="{DynamicResource IdeSecondaryButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
