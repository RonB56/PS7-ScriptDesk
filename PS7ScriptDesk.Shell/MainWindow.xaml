<Window x:Class="PS7ScriptDesk.Shell.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        xmlns:controls="clr-namespace:PS7ScriptDesk.Shell.Controls"
                Title="{Binding Title}"
        Height="700"
        Width="1360"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus"
        AllowDrop="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ToolbarIconPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource Theme.Icon.Accent}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                    <Setter Property="Fill" Value="{DynamicResource Theme.Icon.Muted}" />
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarIconNeutralPathStyle" TargetType="Path" BasedOn="{StaticResource ToolbarIconPathStyle}">
            <Setter Property="Fill" Value="{DynamicResource Theme.Icon.Muted}" />
        </Style>

        <Style x:Key="ToolbarIconPositivePathStyle" TargetType="Path" BasedOn="{StaticResource ToolbarIconPathStyle}">
            <Setter Property="Fill" Value="{DynamicResource Theme.Icon.Success}" />
        </Style>

        <Style x:Key="ToolbarIconWarningPathStyle" TargetType="Path" BasedOn="{StaticResource ToolbarIconPathStyle}">
            <Setter Property="Fill" Value="{DynamicResource Theme.Icon.Warning}" />
        </Style>

        <Style x:Key="ToolbarIconDangerPathStyle" TargetType="Path" BasedOn="{StaticResource ToolbarIconPathStyle}">
            <Setter Property="Fill" Value="{DynamicResource Theme.Icon.Danger}" />
        </Style>

        <Style x:Key="ToolbarIconViewboxStyle" TargetType="Viewbox">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarIconOnlyViewboxStyle" TargetType="Viewbox" BasedOn="{StaticResource ToolbarIconViewboxStyle}">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="PanelCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="×" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CloseButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="{DynamicResource Theme.Surface.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseButtonBorder" Property="Background" Value="{DynamicResource Theme.Surface.Tertiary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>

        <Border x:Name="AdministratorModeBanner"
                DockPanel.Dock="Top"
                Background="{DynamicResource Theme.Status.Error.Background}"
                BorderBrush="{DynamicResource Theme.Status.Error.Border}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="{Binding AdministratorModeBannerVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Administrator mode warning">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ADMINISTRATOR MODE"
                           Foreground="{DynamicResource Theme.Status.Error.Foreground}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding AdministratorModeBannerDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{DynamicResource Theme.Status.Error.Foreground}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Menu DockPanel.Dock="Top" help:ContextHelp.Key="App.Overview">
                <MenuItem x:Name="FileMenuItem"
                      Header="_File"
                      SubmenuOpened="FileMenuItem_SubmenuOpened"
                      help:ContextHelp.Key="Menu.File">
                <MenuItem Header="_New Script" InputGestureText="Ctrl+N" Command="{Binding NewScriptCommand}" help:ContextHelp.Key="Command.NewScript" />
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}" help:ContextHelp.Key="Command.CloseTab" />
                <MenuItem Header="Close _All" InputGestureText="Ctrl+Shift+W" Command="{Binding CloseAllTabsCommand}" help:ContextHelp.Key="Command.CloseAll" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OpenFile_Click" help:ContextHelp.Key="Command.OpenFile" />
                <MenuItem Header="Open _Folder..." InputGestureText="Ctrl+Shift+O" Command="{Binding OpenWorkspaceFolderCommand}" help:ContextHelp.Key="Command.OpenFolder" />
                <Separator x:Name="RecentScriptsSectionTopSeparator" />
                <MenuItem x:Name="RecentScriptsSectionHeaderMenuItem"
                          Header="Recent _Scripts"
                          IsEnabled="False"
                          help:ContextHelp.Key="Menu.RecentScripts" />
                <MenuItem x:Name="RecentScriptsEmptyMenuItem"
                          Header="No recent scripts"
                          IsEnabled="False" />
                <Separator x:Name="RecentScriptsSectionBottomSeparator" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveFile_Click" help:ContextHelp.Key="Command.Save" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveFileAs_Click" help:ContextHelp.Key="Command.SaveAs" />
                <MenuItem Header="Publish as _API" help:ContextHelp.Key="Command.PublishRestApi">
                    <MenuItem Header="_REST API..." Command="{Binding PublishRestApiCommand}" help:ContextHelp.Key="Command.PublishRestApi" />
                </MenuItem>
                <MenuItem Header="Export as E_XE..." Command="{Binding ExportAsExeCommand}" help:ContextHelp.Key="Command.ExportAsExe" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" help:ContextHelp.Key="Menu.File" />
            </MenuItem>

            <MenuItem Header="_Edit" help:ContextHelp.Key="Command.Find">
                <MenuItem Header="Command _Palette..." InputGestureText="Ctrl+Shift+P" Click="CommandPalette_Click" />
                <MenuItem x:Name="AnalyzeCurrentDocumentMenuItem" Header="_Analyze Current Document" Click="AnalyzeCurrentDocument_Click" />
                <MenuItem x:Name="PSScriptAnalyzerEnabledMenuItem" Header="Enable PSScriptAnalyzer" IsCheckable="True" Click="PSScriptAnalyzerEnabled_Click" />
                <MenuItem x:Name="PSScriptAnalyzerAnalyzeWhileEditingMenuItem" Header="Analyze While Editing" IsCheckable="True" Click="PSScriptAnalyzerAnalyzeWhileEditing_Click" />
                <MenuItem Header="PSScriptAnalyzer Severity">
                    <MenuItem x:Name="PSScriptAnalyzerSeverityAllMenuItem" Header="All" IsCheckable="True" Click="PSScriptAnalyzerSeverity_Click" />
                    <MenuItem x:Name="PSScriptAnalyzerSeverityErrorMenuItem" Header="Error" IsCheckable="True" Click="PSScriptAnalyzerSeverity_Click" />
                    <MenuItem x:Name="PSScriptAnalyzerSeverityWarningMenuItem" Header="Warning" IsCheckable="True" Click="PSScriptAnalyzerSeverity_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="Find_Click" help:ContextHelp.Key="Command.Find" />
                <MenuItem Header="_Replace" InputGestureText="Ctrl+H" Click="Replace_Click" help:ContextHelp.Key="Command.Replace" />
                <Separator />
                <MenuItem Header="Go to _Line..." InputGestureText="Ctrl+G" Click="GoToLine_Click" help:ContextHelp.Key="Command.GoToLine" />
                <Separator />
                <MenuItem Header="_Toggle Comment" InputGestureText="Ctrl+/" Click="EditorToggleComment_Click" />
                <MenuItem Header="_Indent" InputGestureText="Tab" Click="EditorIndent_Click" />
                <MenuItem Header="_Outdent" InputGestureText="Shift+Tab" Click="EditorOutdent_Click" />
                <MenuItem Header="Move Line _Up" InputGestureText="Alt+Up" Click="EditorMoveLineUp_Click" />
                <MenuItem Header="Move Line _Down" InputGestureText="Alt+Down" Click="EditorMoveLineDown_Click" />
                <MenuItem Header="Duplicate Line Down" InputGestureText="Shift+Alt+Down" Click="EditorDuplicateDown_Click" />
                <MenuItem Header="_Delete Line" InputGestureText="Ctrl+Shift+K" Click="EditorDeleteLine_Click" />
                <MenuItem Header="Select Current Line" Click="EditorSelectCurrentLine_Click" />
                <Separator />
                <MenuItem Header="_Clear Output" Command="{Binding ClearConsoleCommand}" help:ContextHelp.Key="Command.ClearOutput" />
            </MenuItem>

            <MenuItem Header="_View" help:ContextHelp.Key="View.Menu">
                <MenuItem Header="Show _Explorer"
                          help:ContextHelp.Key="View.Explorer"
                          IsCheckable="True"
                          IsChecked="{Binding IsExplorerVisible, Mode=TwoWay}" />
                <MenuItem x:Name="ShowDebugPanelMenuItem"
                          help:ContextHelp.Key="View.DebugPanels"
                          Header="Show _Debug Panels"
                          IsCheckable="True"
                          IsChecked="False"
                          Click="ShowDebugPanel_Click" />
                <MenuItem x:Name="ShowBottomToolWindowMenuItem"
                          Header="Show _Problems"
                          IsCheckable="True"
                          IsChecked="False"
                          Click="ShowBottomToolWindow_Click" />
                <MenuItem x:Name="PopOutBottomToolWindowMenuItem"
                          Header="Problems / Activity Pop O_ut"
                          Click="PopOutBottomToolWindowMenuItem_Click" />
                <MenuItem x:Name="DockBottomToolWindowMenuItem"
                          Header="Problems / Activity _Dock Back"
                          Click="DockBottomToolWindowMenuItem_Click"
                          Visibility="Collapsed" />
                <MenuItem x:Name="PopOutDebugPaneMenuItem"
                          Header="Debug Pane Pop _Out"
                          Click="PopOutDebugPaneMenuItem_Click" />
                <MenuItem x:Name="DockDebugPaneMenuItem"
                          Header="Debug Pane _Dock Back"
                          Click="DockDebugPaneMenuItem_Click"
                          Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="_Workspace Layout" help:ContextHelp.Key="View.Menu">
                    <MenuItem Header="_Editor Maximized"
                              Click="WorkspaceEditorMaximized_Click" />
                    <MenuItem Header="_Console Maximized"
                              Click="WorkspaceConsoleMaximized_Click" />
                    <MenuItem Header="_Editor + Console Horizontal Split"
                              Click="WorkspaceHorizontalSplit_Click" />
                    <MenuItem Header="Editor + Console _Side-by-Side Split"
                              Click="WorkspaceSideBySideSplit_Click" />
                    <Separator />
                    <MenuItem Header="_Restore Default Workspace"
                              Click="WorkspaceRestoreDefault_Click" />
                    </MenuItem>
                    <Separator />
                <MenuItem x:Name="UiScaleMenuItem"
                          Header="_UI Scale"
                          help:ContextHelp.Key="View.UiScale" />
                <MenuItem Header="Increase UI Scale"
                          InputGestureText="Ctrl+Alt+="
                          Command="{Binding IncreaseUiScaleCommand}"
                          help:ContextHelp.Key="View.UiScale" />
                <MenuItem Header="Decrease UI Scale"
                          InputGestureText="Ctrl+Alt+-"
                          Command="{Binding DecreaseUiScaleCommand}"
                          help:ContextHelp.Key="View.UiScale" />
                <MenuItem Header="Reset UI Scale"
                          InputGestureText="Ctrl+Alt+0"
                          Command="{Binding ResetUiScaleCommand}"
                          help:ContextHelp.Key="View.UiScale" />
                <Separator />
                <MenuItem Header="Zoom _In"  InputGestureText="Ctrl+=" Command="{Binding ZoomInCommand}" help:ContextHelp.Key="View.Zoom" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" help:ContextHelp.Key="View.Zoom" />
                <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Command="{Binding ResetZoomCommand}" help:ContextHelp.Key="View.Zoom" />
                <Separator />
                <MenuItem Header="_Theme" help:ContextHelp.Key="View.ThemeMenu">
                    <MenuItem Header="_Dark"    Click="ThemeDark_Click" help:ContextHelp.Key="Theme.Dark" />
                    <MenuItem Header="_Light"   Click="ThemeLight_Click" help:ContextHelp.Key="Theme.Light" />
                    <MenuItem Header="_ISE Blue" Click="ThemeIseBlue_Click" help:ContextHelp.Key="Theme.IseBlue" />
                </MenuItem>
                <MenuItem Header="Editor _Highlight Colors">
                    <MenuItem x:Name="ForceHighContrastSelectionTextMenuItem"
                              Header="Force _high-contrast selected text"
                              IsCheckable="True"
                              Click="ForceHighContrastSelectionText_Click" />
                    <Separator />
                    <MenuItem Header="_Selection background">
                        <MenuItem x:Name="SelectionThemeDefaultMenuItem" Header="Use active _theme default" IsCheckable="True" Click="SelectionHighlightThemeDefault_Click" />
                        <Separator />
                        <MenuItem x:Name="SelectionPowerShellBlueMenuItem" Header="PowerShell blue" IsCheckable="True" Tag="#0F4C81" Click="SelectionHighlightPreset_Click" />
                        <MenuItem x:Name="SelectionNavyMenuItem" Header="Deep navy" IsCheckable="True" Tag="#0B2A4A" Click="SelectionHighlightPreset_Click" />
                        <MenuItem x:Name="SelectionCharcoalMenuItem" Header="Charcoal" IsCheckable="True" Tag="#374151" Click="SelectionHighlightPreset_Click" />
                        <MenuItem x:Name="SelectionPurpleMenuItem" Header="Purple" IsCheckable="True" Tag="#6D28D9" Click="SelectionHighlightPreset_Click" />
                        <MenuItem x:Name="SelectionGoldMenuItem" Header="Gold" IsCheckable="True" Tag="#F59E0B" Click="SelectionHighlightPreset_Click" />
                        <Separator />
                        <MenuItem Header="_Custom selection color..." Click="SelectionHighlightCustom_Click" />
                    </MenuItem>
                    <MenuItem Header="_Current line background">
                        <MenuItem x:Name="CurrentLineThemeDefaultMenuItem" Header="Use active _theme default" IsCheckable="True" Click="CurrentLineHighlightThemeDefault_Click" />
                        <Separator />
                        <MenuItem x:Name="CurrentLineSubtleNavyMenuItem" Header="Subtle navy" IsCheckable="True" Tag="#082F49" Click="CurrentLineHighlightPreset_Click" />
                        <MenuItem x:Name="CurrentLineSoftSlateMenuItem" Header="Soft slate" IsCheckable="True" Tag="#334155" Click="CurrentLineHighlightPreset_Click" />
                        <MenuItem x:Name="CurrentLineSoftPurpleMenuItem" Header="Soft purple" IsCheckable="True" Tag="#3B0764" Click="CurrentLineHighlightPreset_Click" />
                        <MenuItem x:Name="CurrentLineSoftGoldMenuItem" Header="Soft gold" IsCheckable="True" Tag="#78350F" Click="CurrentLineHighlightPreset_Click" />
                        <Separator />
                        <MenuItem Header="C_ustom current-line color..." Click="CurrentLineHighlightCustom_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Restore highlight defaults" Click="RestoreEditorHighlightDefaults_Click" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Run" help:ContextHelp.Key="Command.RunScript">
                <MenuItem Header="_Run Script" InputGestureText="Ctrl+F5" Click="RunScript_Click" IsEnabled="{Binding IsRunAvailable}" help:ContextHelp.Key="Command.RunScript" />
                <MenuItem Header="Run _Selection" InputGestureText="F8" Click="RunSelection_Click" IsEnabled="{Binding IsRunAvailable}" help:ContextHelp.Key="Command.RunSelection" />
                <MenuItem Header="_Interrupt" Command="{Binding StopCommand}" help:ContextHelp.Key="Command.Interrupt" />
                <Separator />
                <MenuItem x:Name="RefreshEditorMetadataMenuItem"
                          Header="Refresh PowerShell Editor Metadata"
                          Click="RefreshEditorMetadata_Click"
                          help:ContextHelp.Key="Editor.Metadata" />
                <Separator />
                <MenuItem x:Name="DeleteCurrentEditorMetadataCacheMenuItem"
                          Header="Delete Current Runtime Metadata Cache"
                          Click="DeleteCurrentEditorMetadataCache_Click"
                          help:ContextHelp.Key="Editor.Metadata" />
                <MenuItem x:Name="DeleteAllEditorMetadataCachesMenuItem"
                          Header="Delete All PowerShell Metadata Caches"
                          Click="DeleteAllEditorMetadataCaches_Click"
                          help:ContextHelp.Key="Editor.Metadata" />
            </MenuItem>

            <MenuItem Header="_Debug" help:ContextHelp.Key="Debug.Area">
                <MenuItem Header="_Toggle Breakpoint" InputGestureText="F9" Click="ToggleBreakpoint_Click" help:ContextHelp.Key="Command.ToggleBreakpoint" />
                <Separator />
                <MenuItem Header="Open Console Prototype"
                          Click="OpenConsolePrototype_Click"
                          help:ContextHelp.Key="Debug.Area" />
                <Separator />
                <MenuItem x:Name="StartDebugMenuItem" Header="Start _Debug"  InputGestureText="F5" Click="StartDebug_Click" IsEnabled="False" help:ContextHelp.Key="Command.StartDebug" />
                <MenuItem x:Name="StepIntoMenuItem"   Header="Step _Into"    InputGestureText="F11"       Click="StepInto_Click"   IsEnabled="False" help:ContextHelp.Key="Command.StepInto" />
                <MenuItem x:Name="StepOverMenuItem"   Header="Step _Over"    InputGestureText="F10"       Click="StepOver_Click"   IsEnabled="False" help:ContextHelp.Key="Command.StepOver" />
                <MenuItem x:Name="StepOutMenuItem"    Header="Step O_ut"     InputGestureText="Shift+F11" Click="StepOut_Click"    IsEnabled="False" help:ContextHelp.Key="Command.StepOut" />
                <MenuItem x:Name="ContinueMenuItem"   Header="_Continue"     InputGestureText="F5"       Click="ContinueDebug_Click" IsEnabled="False" help:ContextHelp.Key="Command.ContinueDebug" />
                <MenuItem x:Name="StopDebugMenuItem"  Header="Stop D_ebug"  InputGestureText="Shift+F5" Click="StopDebug_Click"  IsEnabled="False" help:ContextHelp.Key="Command.StopDebug" />
            </MenuItem>

            <MenuItem Header="_Tools" help:ContextHelp.Key="Menu.Tools">
                <MenuItem Header="_Developer Diagnostics">
                    <MenuItem x:Name="EnableDeveloperDiagnosticsMenuItem"
                              Header="_Enable Developer Diagnostics"
                              IsCheckable="True"
                              Click="EnableDeveloperDiagnostics_Click" />
                    <Separator />
                    <MenuItem x:Name="VerboseUiLoggingMenuItem"
                              Header="Verbose _UI Logging"
                              IsCheckable="True"
                              Click="VerboseUiLogging_Click" />
                    <MenuItem x:Name="VerboseDebuggerLoggingMenuItem"
                              Header="Verbose _Debugger Logging"
                              IsCheckable="True"
                              Click="VerboseDebuggerLogging_Click" />
                    <MenuItem x:Name="VerboseTerminalLoggingMenuItem"
                              Header="Verbose _Terminal Logging"
                              IsCheckable="True"
                              Click="VerboseTerminalLogging_Click" />
                    <MenuItem x:Name="VerboseEditorLoggingMenuItem"
                              Header="Verbose _Editor Logging"
                              IsCheckable="True"
                              Click="VerboseEditorLogging_Click" />
                    <Separator />
                    <MenuItem Header="_Open Developer Debugging Folder"
                              Click="OpenDeveloperDebuggingFolder_Click" />
                    <MenuItem Header="Open _Latest Diagnostic Session Folder"
                              Click="OpenLatestDiagnosticSessionFolder_Click" />
                    <MenuItem Header="_Copy Diagnostics Summary to Clipboard"
                              Click="CopyDiagnosticsSummaryToClipboard_Click" />
                    <MenuItem Header="_Package Developer Diagnostics for Support"
                              Click="PackageDeveloperDiagnosticsForSupport_Click" />
                    <MenuItem Header="_Clear Developer Diagnostics Logs"
                              Click="ClearDeveloperDiagnosticsLogs_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Create Support _Logs ZIP..."
                          Click="CreateSupportLogsZip_Click"
                          help:ContextHelp.Key="Help.Logs" />
                <MenuItem Header="Open _Diagnostic Logs Folder"
                          Click="OpenLogsFolder_Click"
                          help:ContextHelp.Key="Help.Logs" />
                <MenuItem Header="Copy Diagnostic Logs Folder _Path"
                          Click="CopyLogsFolderPath_Click"
                          help:ContextHelp.Key="Help.Logs" />
            </MenuItem>

            <MenuItem Header="_Help" help:ContextHelp.Key="Help.Menu">
                <MenuItem Header="Context _Help" InputGestureText="F1" Click="ContextHelp_Click" help:ContextHelp.Key="Help.Context" />
                <MenuItem Header="Help _Enabled"
                          IsCheckable="True"
                          IsChecked="{Binding IsContextHelpEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          help:ContextHelp.Key="Help.Context" />
                <MenuItem Header="PS7 ScriptDesk _Help" Click="HelpOverview_Click" help:ContextHelp.Key="App.Overview" />
                <Separator />
                <MenuItem Header="Store Update _Status" Click="CheckForUpdates_Click" help:ContextHelp.Key="App.StoreUpdate" />
                <Separator />
                <MenuItem Header="_About" Click="About_Click" help:ContextHelp.Key="Help.About" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" help:ContextHelp.Key="App.Overview">
            <ToolBar>
                <!-- File/document group -->
                <Button Command="{Binding NewScriptCommand}"
                        help:ContextHelp.Key="Command.NewScript"
                        Style="{StaticResource IdeToolbarPrimaryButtonStyle}"
                        ToolTip="New Script (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 6,0 H 10 V 6 H 16 V 10 H 10 V 16 H 6 V 10 H 0 V 6 H 6 Z"
                                  Style="{StaticResource ToolbarIconPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="New" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="OpenFile_Click"
                        help:ContextHelp.Key="Command.OpenFile"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Open File (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 2,0 H 10 L 14,4 V 16 H 2 Z"
                                  Style="{StaticResource ToolbarIconNeutralPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Open" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenWorkspaceFolderCommand}"
                        help:ContextHelp.Key="Command.OpenFolder"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Open Folder (Ctrl+Shift+O)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 0,5 H 7 L 8,3 H 16 V 14 H 0 Z"
                                  Style="{StaticResource ToolbarIconWarningPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="SaveFile_Click"
                        help:ContextHelp.Key="Command.Save"
                        Style="{StaticResource IdeToolbarPrimaryButtonStyle}"
                        ToolTip="Save (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 4,0 H 12 V 7 H 15 L 8,14 L 1,7 H 4 Z M 0,15 H 16 V 16 H 0 Z"
                                  Style="{StaticResource ToolbarIconPositivePathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CloseTabCommand}"
                        help:ContextHelp.Key="Command.CloseTab"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Close Tab (Ctrl+W)"
                        AutomationProperties.Name="Close Tab">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 2,0 L 8,6 L 14,0 L 16,2 L 10,8 L 16,14 L 14,16 L 8,10 L 2,16 L 0,14 L 6,8 L 0,2 Z"
                                  Style="{StaticResource ToolbarIconNeutralPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Close" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding CloseAllTabsCommand}"
                        help:ContextHelp.Key="Command.CloseAll"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Close All Tabs (Ctrl+Shift+W)"
                        AutomationProperties.Name="Close All Tabs">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 0,2 H 11 V 4 H 0 Z M 2,6 L 6,10 L 10,6 L 12,8 L 8,12 L 12,16 L 10,18 L 6,14 L 2,18 L 0,16 L 4,12 L 0,8 Z M 12,2 H 16 V 4 H 12 Z"
                                  Style="{StaticResource ToolbarIconNeutralPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Close All" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource IdeToolbarSeparatorStyle}" />

                <!-- Run group -->
                <Button Click="RunScript_Click"
                        help:ContextHelp.Key="Command.RunScript"
                        IsEnabled="{Binding IsRunAvailable}"
                        Style="{StaticResource IdeToolbarPrimaryButtonStyle}"
                        ToolTip="Run Script (Ctrl+F5)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 3,2 L 14,8 L 3,14 Z"
                                  Style="{StaticResource ToolbarIconPositivePathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Run" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="RunSelection_Click"
                        help:ContextHelp.Key="Command.RunSelection"
                        IsEnabled="{Binding IsRunAvailable}"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Run Selection (F8). Runs the current selection in the shared PowerShell session, or the current line when nothing is selected.">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 0,2 H 3 V 14 H 0 Z M 5,2 L 15,8 L 5,14 Z"
                                  Style="{StaticResource ToolbarIconPositivePathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Run Selection" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding StopCommand}"
                        help:ContextHelp.Key="Command.Interrupt"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Interrupt. Try to interrupt the current command or script. If PowerShell does not respond, ScriptDesk can restart only its own session and keep your editor tabs open.">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 2,2 H 14 V 14 H 2 Z"
                                  Style="{StaticResource ToolbarIconDangerPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Interrupt" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource IdeToolbarSeparatorStyle}" />

                <!-- Debug group -->
                <Button x:Name="DebugToggleButton"
                        help:ContextHelp.Key="Command.StartDebug"
                        Click="DebugToggle_Click"
                        IsEnabled="False"
                        Style="{StaticResource IdeToolbarPrimaryButtonStyle}"
                        ToolTip="Start Debug (F5). Stop Debug (Shift+F5).">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDebugSessionActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Data="M 3,2 L 14,8 L 3,14 Z"
                                      Style="{StaticResource ToolbarIconPathStyle}" />
                            </Viewbox>
                            <TextBlock Text="Debug" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDebugSessionActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                                <Path Data="M 3,3 H 13 V 13 H 3 Z"
                                      Style="{StaticResource ToolbarIconDangerPathStyle}" />
                            </Viewbox>
                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="ContinueButton"
                        help:ContextHelp.Key="Command.ContinueDebug"
                        Click="ContinueDebug_Click"
                        IsEnabled="False"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Continue (F5)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 0,2 L 7,8 L 0,14 Z M 8,2 L 15,8 L 8,14 Z"
                                  Style="{StaticResource ToolbarIconPositivePathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Continue" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="StepOverButton"
                        help:ContextHelp.Key="Command.StepOver"
                        Click="StepOver_Click"
                        IsEnabled="False"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Step Over (F10)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 0,6 H 10 L 7,3 L 10,6 L 7,9 M 0,12 H 16 V 13 H 0 Z"
                                  Style="{StaticResource ToolbarIconPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Step Over" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="StepIntoButton"
                        help:ContextHelp.Key="Command.StepInto"
                        Click="StepInto_Click"
                        IsEnabled="False"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Step Into (F11)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 8,0 V 10 L 5,7 H 3 L 8,13 L 13,7 H 11 L 8,10 V 0"
                                  Style="{StaticResource ToolbarIconPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Step Into" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="StepOutButton"
                        help:ContextHelp.Key="Command.StepOut"
                        Click="StepOut_Click"
                        IsEnabled="False"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Step Out (Shift+F11)">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 8,16 V 6 L 5,9 H 3 L 8,3 L 13,9 H 11 L 8,6 V 16 M 0,2 H 16 V 3 H 0 Z"
                                  Style="{StaticResource ToolbarIconPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Step Out" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource IdeToolbarSeparatorStyle}" />

                <!-- Output group -->
                <Button Command="{Binding ClearConsoleCommand}"
                        help:ContextHelp.Key="Command.ClearOutput"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="Clear Output">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 6,2 L 0,8 L 6,14 H 16 V 2 Z"
                                  Style="{StaticResource ToolbarIconWarningPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Clear" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource IdeToolbarSeparatorStyle}" />

                <!-- Help group -->
                <Button Click="HelpOverview_Click"
                        help:ContextHelp.Key="App.Overview"
                        Style="{StaticResource IdeToolbarButtonStyle}"
                        ToolTip="PS7 ScriptDesk Help">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Style="{StaticResource ToolbarIconViewboxStyle}">
                            <Path Data="M 8,0 A 8,8 0 1 1 7.99,0 Z M 7,4 H 9 V 5 H 7 Z M 6.2,7.2 C 6.3,5.6 7.1,4.8 8.4,4.8 C 9.7,4.8 10.6,5.6 10.6,6.9 C 10.6,8.0 10.0,8.6 9.1,9.2 C 8.2,9.8 8.0,10.1 8.0,11.0 V 11.4 H 6.8 V 10.8 C 6.8,9.7 7.2,9.1 8.1,8.5 C 8.8,8.0 9.3,7.6 9.3,6.8 C 9.3,6.0 8.8,5.5 8.1,5.5 C 7.3,5.5 6.8,6.1 6.8,7.2 Z"
                                  Style="{StaticResource ToolbarIconPathStyle}" />
                        </Viewbox>
                        <TextBlock Text="Help" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" help:ContextHelp.Key="Status.General">
            <StatusBarItem help:ContextHelp.Key="Status.Version">
                <TextBlock Text="{Binding VersionText}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.General">
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}"
                       Visibility="{Binding HasSessionRestoreNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StatusBarItem Visibility="{Binding HasSessionRestoreNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding SessionRestoreNoticeText}"
                           ToolTip="{Binding SessionRestoreNoticeToolTip}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Caret">
                <TextBlock Text="{Binding SelectedTab.CaretDisplayText, TargetNullValue='Ln 1, Col 1'}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Lines">
                <TextBlock Text="{Binding SelectedTab.EditorMetricsText, TargetNullValue=Lines: 1}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Selection">
                <TextBlock Text="{Binding SelectedTab.SelectionDisplayText, TargetNullValue=Selection: None}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Breakpoints">
                <TextBlock Text="{Binding SelectedTab.BreakpointDisplayText, TargetNullValue=Breakpoints: None}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Runtime">
                <TextBlock Text="{Binding RuntimeText}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Workspace">
                <TextBlock Text="{Binding WorkspaceText}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Zoom">
                <TextBlock Text="{Binding ZoomLevelText}" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.UiScale">
                <TextBlock Text="{Binding UiScaleText}"
                           ToolTip="Application interface scale. Editor Zoom and terminal font size are separate settings." />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Status.Execution">
                <TextBlock Text="{Binding ExecutionProgressText}"
                           Foreground="{DynamicResource Theme.Status.Warning.Foreground}"
                           FontWeight="SemiBold" />
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem x:Name="EditorMetadataStatusItem"
                           help:ContextHelp.Key="Editor.Metadata"
                           Visibility="Collapsed">
                <Border x:Name="EditorMetadataStatusBadge"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="4,0"
                        ToolTip="PowerShell editor metadata is still loading in the background.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="EditorMetadataStatusGlyph"
                                   Text="⏳"
                                   Margin="0,0,5,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Theme.Icon.Warning}" />
                        <TextBlock x:Name="EditorMetadataStatusTextBlock"
                                   Text="Editor metadata loading..."
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource Theme.FontSize.Caption}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   Foreground="{DynamicResource Theme.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </StatusBarItem>
            <Separator Style="{StaticResource IdeStatusBarSeparatorStyle}" />
            <StatusBarItem help:ContextHelp.Key="Help.Context">
                <ToggleButton Style="{StaticResource StatusBarHelpToggleButtonStyle}"
                              ToolTip="Turn advanced context help on or off"
                              IsChecked="{Binding IsContextHelpEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="?"
                                   Margin="0,0,5,0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Help off" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Text" Value="Help on" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="EditorRowDefinition" Height="*" />
                <RowDefinition x:Name="EditorConsoleRowSplitterDefinition" Height="6" />
                <RowDefinition x:Name="ConsoleRowDefinition" Height="180" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumnDefinition" Width="220" MinWidth="190" />

                <ColumnDefinition x:Name="ExplorerSplitterColumnDefinition" Width="6" />

                <ColumnDefinition x:Name="EditorColumnDefinition" Width="*" />

                <ColumnDefinition x:Name="ConsoleSideSplitterColumnDefinition" Width="0" />

                <ColumnDefinition x:Name="ConsoleSideColumnDefinition" Width="0" MinWidth="0" />

                <ColumnDefinition x:Name="DebugPanelSplitterColumn" Width="0" />

                <ColumnDefinition x:Name="DebugPanelColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    help:ContextHelp.Key="Explorer.Area"
                    Padding="8"
                    Style="{StaticResource IdePaneBorderStyle}"
                    BorderThickness="0,0,1,0"
                    Margin="0"
                    Visibility="{Binding IsExplorerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="WorkspaceTreeRowDefinition" Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition x:Name="OpenTabsRowDefinition" Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="False"
                               Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Explorer"
                                   Style="{StaticResource IdeSectionHeaderTextStyle}" />
                        <Button x:Name="CloseExplorerPanelButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource PanelCloseButtonStyle}"
                                ToolTip="Hide Explorer panel"
                                AutomationProperties.Name="Hide Explorer panel"
                                Click="CloseExplorerPanelButton_Click" />
                    </DockPanel>

                    <GroupBox Grid.Row="1"
                              Header="PowerShell Runtime"
                              help:ContextHelp.Key="Runtime.Area"
                              Margin="0,0,0,6"
                              Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,4"
                                  help:ContextHelp.Key="Runtime.Area">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedRuntimeCompactText}"
                                               Style="{StaticResource IdeToolWindowPrimaryTextStyle}"
                                               ToolTip="{Binding SelectedRuntimeCompactText}" />

                                    <TextBlock Margin="0,1,0,0"
                                               Text="{Binding RunningRuntimeCompactText}"
                                               Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                               TextWrapping="NoWrap"
                                               Visibility="{Binding HasRunningRuntimeCompactText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               ToolTip="{Binding RunningRuntimeCompactText}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        help:ContextHelp.Key="Runtime.Refresh"
                                        Content="{Binding RefreshRuntimesButtonText}"
                                        Command="{Binding RefreshRuntimesCommand}"
                                        Style="{StaticResource IdeSecondaryButtonStyle}"
                                        MinWidth="76"
                                        VerticalAlignment="Top" />
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,4"
                                  help:ContextHelp.Key="Runtime.Path">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Path"
                                           Style="{StaticResource IdeToolWindowLabelTextStyle}"
                                           Margin="0,0,6,0" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedRuntimePathOnlyText, Mode=OneWay}"
                                           Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedRuntimePathOnlyText}" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding RuntimeListHeaderText}"
                                           Style="{StaticResource IdeToolWindowLabelTextStyle}" />

                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Text="{Binding RuntimeSelectionStatusText}"
                                           Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                           TextWrapping="NoWrap"
                                           ToolTip="{Binding RuntimeSelectionStatusText}" />
                            </Grid>

                            <ListBox Grid.Row="3"
                                     help:ContextHelp.Key="Runtime.List"
                                     Margin="0"
                                     MinHeight="64"
                                     MaxHeight="112"
                                     IsEnabled="{Binding IsRuntimeListEnabled}"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemsSource="{Binding DetectedRuntimes}"
                                     ItemContainerStyle="{StaticResource IdeToolWindowListBoxItemStyle}"
                                     SelectedItem="{Binding SelectedRuntimeItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="2"
                          Margin="0,0,0,6"
                          help:ContextHelp.Key="Explorer.WorkspaceSummary">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0"
                                   Margin="0,0,0,2">
                            <TextBlock Text="{Binding OpenTabCountText}"
                                       Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                       TextWrapping="NoWrap"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding WorkspaceFileCountText}"
                                       Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                       TextWrapping="NoWrap"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding WorkspaceFolderCountText}"
                                       Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                       TextWrapping="NoWrap" />
                        </WrapPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding CurrentWorkspaceText}"
                                   Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                   TextWrapping="NoWrap"
                                   Margin="0,0,0,1"
                                   ToolTip="{Binding CurrentWorkspaceText}" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding SelectedWorkspacePathText}"
                                   Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding SelectedWorkspacePathText}" />
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,0,0,6" help:ContextHelp.Key="Explorer.WorkspaceFilter">
                        <TextBlock Text="Workspace Filter"
                                   Style="{StaticResource IdeToolWindowLabelTextStyle}"
                                   Margin="0,0,0,2" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBox x:Name="WorkspaceFilterBox"
                                         help:ContextHelp.Key="Explorer.WorkspaceFilter"
                                         Text="{Binding WorkspaceFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Padding="6,1,6,1"
                                         MinHeight="24"
                                         ToolTip="Type to filter the already-loaded workspace. Filtering now uses the cached workspace instead of rescanning the drive each time." />
                                <TextBlock Text="Type to filter loaded workspace"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.Text.Secondary}"
                                           FontSize="{StaticResource Theme.FontSize.Caption}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=WorkspaceFilterBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                                <Button help:ContextHelp.Key="Explorer.WorkspaceRefresh"
                                        Content="{Binding RefreshWorkspaceButtonText}"
                                        Command="{Binding RefreshWorkspaceCommand}"
                                        IsEnabled="{Binding IsWorkspaceCommandsEnabled}"
                                        Style="{StaticResource IdeSecondaryButtonStyle}"
                                        Margin="0,0,4,4"
                                        MinWidth="62" />

                                <Button help:ContextHelp.Key="Command.OpenFolder"
                                        Content="Open Folder"
                                        Command="{Binding OpenWorkspaceFolderCommand}"
                                        IsEnabled="{Binding IsWorkspaceCommandsEnabled}"
                                        Style="{StaticResource IdeSecondaryButtonStyle}"
                                        Margin="0,0,4,4"
                                        MinWidth="80"
                                        ToolTip="Choose a workspace folder and load it into the explorer pane." />

                                <Button help:ContextHelp.Key="Explorer.ShowInExplorer"
                                        Content="Show in Explorer"
                                        Command="{Binding ShowWorkspaceFolderInExplorerCommand}"
                                        IsEnabled="{Binding IsWorkspaceCommandsEnabled}"
                                        Style="{StaticResource IdeSecondaryButtonStyle}"
                                        Margin="0,0,0,4"
                                        MinWidth="96"
                                        ToolTip="Open the current workspace folder in Windows Explorer. If a file is selected, Windows Explorer will highlight it there." />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>

                    <GroupBox Grid.Row="4"
                              help:ContextHelp.Key="Explorer.WorkspaceTree"
                              Header="{Binding WorkspaceGroupHeaderText}"
                              MinHeight="0"
                              Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding WorkspaceLoadingText}"
                                       Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                       Margin="0,0,0,4" />

                            <TreeView x:Name="WorkspaceTree"
                                      help:ContextHelp.Key="Explorer.WorkspaceTree"
                                      Grid.Row="1"
                                      MinHeight="0"
                                      ItemsSource="{Binding WorkspaceItems}"
                                      SelectedItemChanged="WorkspaceTree_SelectedItemChanged"
                                      MouseDoubleClick="WorkspaceTree_MouseDoubleClick"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <EventSetter Event="Expanded" Handler="WorkspaceTreeItem_Expanded" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding DisplayText}" />
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </GroupBox>

                    <GridSplitter Grid.Row="5"
                                  Style="{StaticResource IdeRowSplitterStyle}" />

                    <GroupBox Grid.Row="6"
                              help:ContextHelp.Key="Explorer.OpenTabs"
                              Header="Open Tabs"
                              MinHeight="0"
                              Padding="0">
                        <Grid MinHeight="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding ActiveDocumentText}"
                                       Style="{StaticResource IdeToolWindowMetaTextStyle}"
                                       Margin="0,0,0,6"
                                       ToolTip="{Binding ActiveDocumentText}" />

                            <ListBox Grid.Row="1"
                                     help:ContextHelp.Key="Explorer.OpenTabs"
                                     MinHeight="0"
                                     ItemsSource="{Binding OpenTabs}"
                                     ItemContainerStyle="{StaticResource IdeToolWindowListBoxItemStyle}"
                                     SelectedItem="{Binding SelectedTab}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayTitle}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="1"
                          Style="{StaticResource IdeColumnSplitterStyle}"
                          Visibility="{Binding IsExplorerVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border x:Name="EditorPaneBorder" Grid.Row="0"
                    help:ContextHelp.Key="Editor.Area"
                    Grid.Column="2"
                    Padding="6"
                    Style="{StaticResource IdePaneBorderStyle}"
                    BorderThickness="0"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TabControl ItemsSource="{Binding OpenTabs}"
                                    help:ContextHelp.Key="Editor.TabStrip"
                                    ItemContainerStyle="{StaticResource IdeCompactEditorTabItemStyle}"
                                    SelectedItem="{Binding SelectedTab}">
                            <TabControl.Template>
                                <ControlTemplate TargetType="{x:Type TabControl}">
                                    <Grid KeyboardNavigation.TabNavigation="Local">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0"
                                                   LastChildFill="False"
                                                   Margin="0,0,0,4">
                                            <TabPanel x:Name="HeaderPanel"
                                                      DockPanel.Dock="Left"
                                                      IsItemsHost="True"
                                                      KeyboardNavigation.TabIndex="1"
                                                      Background="Transparent"
                                                      Panel.ZIndex="1" />

                                            <Button DockPanel.Dock="Left"
                                                    help:ContextHelp.Key="Editor.PlusTab"
                                                    VerticalAlignment="Top"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="2,2,0,0"
                                                    Padding="0"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    ToolTip="Open a new blank tab"
                                                    Command="{Binding DataContext.NewScriptCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Content="+" />
                                        </DockPanel>

                                        <ContentPresenter Grid.Row="1"
                                                          x:Name="PART_SelectedContentHost"
                                                          ContentSource="SelectedContent" />
                                    </Grid>
                                </ControlTemplate>
                            </TabControl.Template>

                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" help:ContextHelp.Key="Editor.TabStrip">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   ToolTip="{Binding FilePath, TargetNullValue=Unsaved document}" />
                                        <Button Content="x"
                                                help:ContextHelp.Key="Editor.CloseTabButton"
                                                Width="16"
                                                Height="16"
                                                Padding="0"
                                                Margin="0"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                ToolTip="Close tab"
                                                AutomationProperties.Name="Close tab"
                                                Command="{Binding DataContext.CloseTabCommand, ElementName=RootWindow}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>

                            <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Border help:ContextHelp.Key="Editor.Surface"
                                                Style="{StaticResource EditorSurfaceBorderStyle}">
                                            <avalonedit:TextEditor FontFamily="Consolas"
                                                                       help:ContextHelp.Key="Editor.Surface"
                                                                       FontSize="14"
                                                                       Background="{DynamicResource Theme.Editor.Background}"
                                                                       Foreground="{DynamicResource Theme.Editor.Foreground}"
                                                                       LineNumbersForeground="{DynamicResource Theme.Editor.LineNumber}"
                                                                       ShowLineNumbers="True"
                                                                       HorizontalScrollBarVisibility="Auto"
                                                                       VerticalScrollBarVisibility="Auto"
                                                                       Loaded="EditorTextEditor_Loaded"
                                                                       Unloaded="EditorTextEditor_Unloaded"
                                                                       DataContextChanged="EditorTextEditor_DataContextChanged"
                                                                       AllowDrop="True"
                                                                       PreviewDragOver="EditorTextEditor_PreviewDragOver"
                                                                       Drop="EditorTextEditor_Drop">
                                                <avalonedit:TextEditor.ContextMenu>
                                                    <ContextMenu Opened="EditorContextMenu_Opened">
                                                        <MenuItem Header="Cut"
                                                                  help:ContextHelp.Key="Editor.Surface"
                                                                  InputGestureText="Ctrl+X"
                                                                  Click="EditorCut_Click" />
                                                        <MenuItem Header="Copy"
                                                                  help:ContextHelp.Key="Editor.Surface"
                                                                  InputGestureText="Ctrl+C"
                                                                  Click="EditorCopy_Click" />
                                                        <MenuItem Header="Paste"
                                                                  help:ContextHelp.Key="Editor.Surface"
                                                                  InputGestureText="Ctrl+V"
                                                                  Click="EditorPaste_Click" />
                                                        <Separator />
                                                        <MenuItem x:Name="AvailableCommandsMenu"
                                                                  Header="Available Commands" />
                                                        <MenuItem Header="Select All"
                                                                  help:ContextHelp.Key="Editor.Surface"
                                                                  InputGestureText="Ctrl+A"
                                                                  Click="EditorSelectAll_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Run Selection"
                                                                  help:ContextHelp.Key="Command.RunSelection"
                                                                  InputGestureText="F8"
                                                                  IsEnabled="{Binding DataContext.IsRunAvailable, Source={x:Reference RootWindow}}"
                                                                  Click="RunSelection_Click" />
                                                        <MenuItem Header="Toggle Breakpoint"
                                                                  help:ContextHelp.Key="Command.ToggleBreakpoint"
                                                                  InputGestureText="F9"
                                                                  Click="ToggleBreakpoint_Click" />
                                                        <Separator />
                                                        <MenuItem Header="Find"
                                                                  help:ContextHelp.Key="Command.Find"
                                                                  InputGestureText="Ctrl+F"
                                                                  Click="Find_Click" />
                                                        <MenuItem Header="Replace"
                                                                  help:ContextHelp.Key="Command.Replace"
                                                                  InputGestureText="Ctrl+H"
                                                                  Click="Replace_Click" />
                                                    </ContextMenu>
                                                </avalonedit:TextEditor.ContextMenu>
                                            </avalonedit:TextEditor>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            help:ContextHelp.Key="Editor.Footer"
                                            Margin="0,4,0,0"
                                            Style="{StaticResource IdeCompactEditorStatusStripBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding CaretDisplayText}"
                                                       FontSize="{StaticResource Theme.FontSize.Caption}"
                                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding EditorMetricsText}"
                                                       FontSize="{StaticResource Theme.FontSize.Caption}"
                                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectionDisplayText}"
                                                       FontSize="{StaticResource Theme.FontSize.Caption}"
                                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SelectionDisplayText}"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding BreakpointDisplayText}"
                                                       FontSize="{StaticResource Theme.FontSize.Caption}"
                                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding BreakpointDisplayText}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="EditorConsoleRowSplitter"
                          Grid.Row="1"
                          Grid.Column="2"
                          Style="{StaticResource IdeRowSplitterStyle}" />

            <GridSplitter x:Name="EditorConsoleColumnSplitter"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="3"
                          Style="{StaticResource IdeColumnSplitterStyle}"
                          Visibility="Collapsed" />

            <Border x:Name="ConsolePaneBorder"
                    Grid.Row="2"
                    help:ContextHelp.Key="Console.Area"
                    Grid.Column="2"
                    Padding="6"
                    Style="{StaticResource IdePaneBorderStyle}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ConsoleContentRowDefinition" Height="*" MinHeight="160" />
                        <RowDefinition x:Name="BottomToolWindowSplitterRowDefinition" Height="0" />
                        <RowDefinition x:Name="BottomToolWindowRowDefinition" Height="0" MinHeight="0" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="ConsoleBottomPaneTab"
                                          IsChecked="True"
                                          MinWidth="72"
                                          Margin="0,0,2,0"
                                          Content="Console"
                                          Style="{StaticResource IdeBottomPaneTabToggleButtonStyle}"
                                          Click="ConsoleBottomPaneTab_Click"
                                          help:ContextHelp.Key="Console.Area" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <Border Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BottomPaneHeaderBadgeBorderStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="{DynamicResource Theme.Status.Error.Background}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Error.Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.HasSyntaxErrors}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedTab.DiagnosticErrorCount, StringFormat={}{0} errors}"
                                           Foreground="{DynamicResource Theme.Status.Error.Foreground}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BottomPaneHeaderBadgeBorderStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="{DynamicResource Theme.Status.Warning.Background}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Warning.Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.HasDiagnosticWarnings}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedTab.DiagnosticWarningCount, StringFormat={}{0} warnings}"
                                           Foreground="{DynamicResource Theme.Status.Warning.Foreground}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid x:Name="ConsoleBottomPane"
                              Margin="0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Console header: session status, Reset Console button -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="{Binding ConsoleSessionText}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.Text.Secondary}"
                                           help:ContextHelp.Key="Console.Area" />

                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="ResetConsoleButton"
                                            Content="Reset Console"
                                            Command="{Binding RestartConsoleCommand}"
                                            PreviewMouseLeftButtonDown="ResetConsoleButton_PreviewMouseLeftButtonDown"
                                            Style="{StaticResource IdeSecondaryButtonStyle}"
                                            Margin="8,0,0,0"
                                            MinWidth="110"
                                            ToolTip="Start a fresh PowerShell session for the console. Editor tabs stay open."
                                            help:ContextHelp.Key="Console.Reset" />
                                </StackPanel>
                            </DockPanel>

                            <!-- xterm.js terminal — replaces the old TextBox + command-input row -->
                            <controls:TerminalControl x:Name="TerminalConsole"
                                                      Grid.Row="1"
                                                      help:ContextHelp.Key="Console.Output" />
                        </Grid>
                    </Grid>

                    <GridSplitter x:Name="BottomToolWindowSplitter"
                          Grid.Row="2"
                          Style="{StaticResource IdeRowSplitterStyle}"
                          Visibility="Collapsed" />

            <Border x:Name="BottomToolWindowBorder"
                    Grid.Row="3"
                    Padding="6"
                    Style="{StaticResource IdePaneBorderStyle}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Grid x:Name="BottomToolWindowDockHost">
                    <Grid x:Name="BottomToolWindowContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Problems / Debug Output / Activity"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource IdeSectionHeaderTextStyle}" />

                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="BottomToolWindowPopOutButton"
                                        Content="Pop Out"
                                        Style="{StaticResource IdeSecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        ToolTip="Pop out Problems, Debug Output, and Activity together"
                                        AutomationProperties.Name="Pop out Problems, Debug Output, and Activity"
                                        Click="PopOutBottomToolWindowButton_Click" />
                                <Button x:Name="BottomToolWindowDockBackButton"
                                        Content="Dock Back"
                                        Style="{StaticResource IdeSecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        ToolTip="Dock Problems, Debug Output, and Activity below the console"
                                        AutomationProperties.Name="Dock back Problems, Debug Output, and Activity"
                                        Click="DockBottomToolWindowButton_Click" />
                                <Button x:Name="BottomToolWindowHideButton"
                                        Style="{StaticResource PanelCloseButtonStyle}"
                                        ToolTip="Hide Problems, Debug Output, and Activity"
                                        AutomationProperties.Name="Hide Problems, Debug Output, and Activity"
                                        Click="HideBottomToolWindowButton_Click" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="BottomProblemsToolTab"
                                          Grid.Column="0"
                                          IsChecked="True"
                                          Content="Problems"
                                          Style="{StaticResource IdeBottomPaneTabToggleButtonStyle}"
                                          Click="BottomProblemsToolTab_Click"
                                          help:ContextHelp.Key="Editor.SyntaxPanel" />

                            <ToggleButton x:Name="BottomDebugOutputToolTab"
                                          Grid.Column="1"
                                          Content="Debug Output"
                                          ToolTip="Output from the separate PowerShell debugger process"
                                          Style="{StaticResource IdeBottomPaneTabToggleButtonStyle}"
                                          Click="BottomDebugOutputToolTab_Click"
                                          help:ContextHelp.Key="Debug.Area" />

                            <ToggleButton x:Name="BottomActivityToolTab"
                                          Grid.Column="2"
                                          Content="Activity"
                                          ToolTip="Application messages and operation details"
                                          Style="{StaticResource IdeBottomPaneTabToggleButtonStyle}"
                                          Click="BottomActivityToolTab_Click" />
                        </Grid>

                        <Grid Grid.Row="2">

                        <Grid x:Name="DiagnosticsBottomPane"
                              Margin="0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=BottomProblemsToolTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                                    <TextBlock Text="Problems"
                                               Style="{StaticResource IdeSectionHeaderTextStyle}"
                                               help:ContextHelp.Key="Editor.SyntaxPanel" />
                                    <TextBlock Text="{Binding SelectedTab.SyntaxErrorSummaryText, TargetNullValue=No active document}"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource Theme.Text.Secondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Text="No problems for the active document."
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource Theme.Text.Secondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.HasDiagnostics}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedTab.SyntaxErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DiagnosticsItemButtonStyle}"
                                                    Click="SyntaxDiagnosticItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Padding="6,2"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.Status.Error.Background}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Error.Border}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Theme.Status.Warning.Background}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Status.Warning.Border}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Severity}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Error.Foreground}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Warning.Foreground}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   TextWrapping="Wrap"
                                                                   FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SourceId}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="  " Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding RuleId}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Click to navigate to this diagnostic"
                                                                   Style="{StaticResource CaptionTextStyle}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="DebugOutputBottomPane"
                              Margin="0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=BottomDebugOutputToolTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Debugger Process Output"
                                       Margin="0,0,0,4"
                                       Style="{StaticResource IdeSectionHeaderTextStyle}"
                                       help:ContextHelp.Key="Debug.Area" />

                            <TextBox Grid.Row="1"
                                     Text="{Binding DebuggerOutputText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     ToolTip="Output from the separate PowerShell debugger process. Interactive PowerShell remains in Console."
                                     help:ContextHelp.Key="Debug.Area" />
                        </Grid>

                        <Grid x:Name="ActivityBottomPane"
                              Margin="0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=BottomActivityToolTab}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Application Activity"
                                       Margin="0,0,0,4"
                                       Style="{StaticResource IdeSectionHeaderTextStyle}" />

                            <TextBox Grid.Row="1"
                                     Text="{Binding ApplicationActivityText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     ToolTip="Application notifications, warnings, and operation details. Interactive PowerShell output remains in Console." />
                        </Grid>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
                </Grid>
            </Border>
            <!-- Debug splitter — only visible when debug panel is open -->
            <GridSplitter Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="5"
                          x:Name="DebugPanelSplitter"
                          Style="{StaticResource IdeColumnSplitterStyle}"
                          Visibility="Collapsed" />

            <!-- Debug panels — Variables / Call Stack / Breakpoints -->
            <Border x:Name="DebugPanelBorder"
                    help:ContextHelp.Key="Debug.Area"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="6"
                    Padding="8"
                    Style="{StaticResource IdePaneBorderStyle}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="False"
                               Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right">
                            <Button x:Name="PopOutDebugPaneButton"
                                    Content="Pop Out"
                                    Style="{StaticResource IdeSecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    ToolTip="Pop out debug pane"
                                    AutomationProperties.Name="Pop out debug pane"
                                    Click="PopOutDebugPaneButton_Click" />
                            <Button x:Name="CloseDebugPanelButton"
                                    Style="{StaticResource PanelCloseButtonStyle}"
                                    ToolTip="Hide Debug panel"
                                    AutomationProperties.Name="Hide Debug panel"
                                    Click="CloseDebugPanelButton_Click" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Debug"
                                   Style="{StaticResource IdeSectionHeaderTextStyle}" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <TabControl x:Name="DebugPaneTabControl"
                                    help:ContextHelp.Key="Debug.Area"
                                    ItemContainerStyle="{StaticResource IdeTabItemStyle}"
                                    SelectionChanged="DebugPaneTabControl_SelectionChanged">

                            <!-- Variables tab -->
                            <TabItem Header="Variables" help:ContextHelp.Key="Debug.Variables">
                                <Grid Margin="0,4,0,0">
                                    <DataGrid x:Name="DebugVariablesGrid"
                                              help:ContextHelp.Key="Debug.Variables"
                                              Style="{StaticResource IdeToolWindowDataGridStyle}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              GridLinesVisibility="Horizontal"
                                              FontFamily="Consolas"
                                              FontSize="12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name"  Binding="{Binding Name}"  Width="80" />
                                            <DataGridTextColumn Header="Type"  Binding="{Binding Type}"  Width="70" />
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No variables available.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource IdeEmptyPaneTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=DebugVariablesGrid}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>

                            <!-- Call Stack tab -->
                            <TabItem Header="Call Stack" help:ContextHelp.Key="Debug.CallStack">
                                <Grid Margin="0,4,0,0">
                                    <DataGrid x:Name="DebugCallStackGrid"
                                              help:ContextHelp.Key="Debug.CallStack"
                                              Style="{StaticResource IdeToolWindowDataGridStyle}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              GridLinesVisibility="Horizontal"
                                              FontFamily="Consolas"
                                              FontSize="12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Function" Binding="{Binding FunctionName}" Width="100" />
                                            <DataGridTextColumn Header="Script"   Binding="{Binding ScriptName}"   Width="*" />
                                            <DataGridTextColumn Header="Line"     Binding="{Binding LineNumber}"   Width="45" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="No active call stack.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource IdeEmptyPaneTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=DebugCallStackGrid}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </TabItem>

                            <!-- Breakpoints tab -->
                            <TabItem Header="Breakpoints" help:ContextHelp.Key="Debug.Breakpoints">
                                <Grid Margin="0,4,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="DebugBreakpointsGrid"
                                              help:ContextHelp.Key="Debug.Breakpoints"
                                              Grid.Row="0"
                                              Style="{StaticResource IdeToolWindowDataGridStyle}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              GridLinesVisibility="Horizontal"
                                              FontFamily="Consolas"
                                              FontSize="12">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On"   Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="30" />
                                            <DataGridTextColumn    Header="File"  Binding="{Binding FileName}"  Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn    Header="Line"  Binding="{Binding LineNumber}" Width="45" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="0"
                                               Text="No breakpoints configured.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource IdeEmptyPaneTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=DebugBreakpointsGrid}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Row="1"
                                            help:ContextHelp.Key="Debug.RemoveBreakpoint"
                                            Content="Remove Selected"
                                            Margin="0,6,0,0"
                                            Style="{StaticResource IdeSecondaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Click="DebugBreakpointRemove_Click" />
                                </Grid>
                            </TabItem>

                        </TabControl>

                        <Border x:Name="DebugPanePoppedOutPlaceholder"
                                Visibility="Collapsed"
                                BorderBrush="{DynamicResource Theme.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Background="{DynamicResource Theme.Surface.Secondary}"
                                Padding="14">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Debug pane is popped out."
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Variables, Call Stack, and Breakpoints are showing in a separate window."
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <Button x:Name="DockBackDebugPaneButton"
                                        Content="Dock Back"
                                        Style="{StaticResource IdeSecondaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="DockDebugPaneButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </DockPanel>

        <Border x:Name="MetadataToastHost"
                Panel.ZIndex="400"
                Visibility="Collapsed"
                Opacity="0"
                MaxWidth="440"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,104,20,0"
                IsHitTestVisible="False">
            <Border x:Name="MetadataToastCard"
                    Style="{StaticResource IdeDialogPanelStyle}"
                    Background="{DynamicResource Theme.Surface.Primary}"
                    BorderBrush="{DynamicResource Theme.Border.Strong}"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            CornerRadius="4"
                            Background="{DynamicResource Theme.Surface.Secondary}"
                            BorderBrush="{DynamicResource Theme.Border.Subtle}"
                            BorderThickness="1">
                        <TextBlock x:Name="MetadataToastGlyph"
                                   Text="⏳"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Icon.Accent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="MetadataToastTitleTextBlock"
                               Grid.Row="0"
                               Grid.Column="1"
                               Text="Preparing PowerShell editor metadata"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="MetadataToastBodyTextBlock"
                               Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.Text.Secondary}"
                               Text="PS7 ScriptDesk is loading command, parameter, syntax, and help metadata for this PowerShell runtime." />

                    <ProgressBar x:Name="MetadataToastProgressBar"
                                 Grid.Row="2"
                                 Grid.ColumnSpan="2"
                                 Height="6"
                                 Margin="0,14,0,0"
                                 IsIndeterminate="True"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0.5" />

                    <TextBlock x:Name="MetadataToastPhaseTextBlock"
                               Grid.Row="3"
                               Grid.ColumnSpan="2"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.Text.Secondary}"
                               FontSize="{StaticResource Theme.FontSize.Caption}"
                               Text="You can keep using the editor while this runs." />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
