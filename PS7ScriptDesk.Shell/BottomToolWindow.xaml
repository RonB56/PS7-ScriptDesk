<Window x:Class="PS7ScriptDesk.Shell.BottomToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:PS7ScriptDesk.Shell.Help"
        Title="Problems / Debug Output / Activity"
        Width="640"
        Height="360"
        MinWidth="360"
        MinHeight="220"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.App.Background}"
        Foreground="{DynamicResource Theme.Text.Primary}"
        Style="{DynamicResource IdeToolWindowStyle}"
        AutomationProperties.Name="Problems, Debug Output, and Activity"
        help:ContextHelp.Key="Debug.Area"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="{DynamicResource Padding.SubtleCard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{DynamicResource IdeToolWindowHeaderStyle}">
            <TextBlock Text="Problems / Debug Output / Activity"
                       Style="{DynamicResource IdeToolWindowHeaderTextStyle}"
                       AutomationProperties.Name="Floating tool window title" />
        </Border>
        <Border Grid.Row="1" Style="{DynamicResource IdeToolWindowContentBorderStyle}">
            <ContentControl x:Name="ToolContentHost"
                            AutomationProperties.Name="Floating tool window content" />
        </Border>
    </Grid>
</Window>
