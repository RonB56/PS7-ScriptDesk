<Window x:Class="PS7ScriptDesk.Shell.MetadataInitializationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS7 ScriptDesk initialization"
        Width="440"
        SizeToContent="Height"
        MinHeight="120"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="PS7 ScriptDesk initialization progress">
    <Border x:Name="CardBorder"
            Margin="8"
            Padding="16"
            Style="{StaticResource IdeDialogPanelStyle}"
            Background="{DynamicResource Theme.Surface.Primary}"
            BorderBrush="{DynamicResource Theme.Border.Strong}"
            BorderThickness="1"
            Effect="{DynamicResource CardShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Margin="0,0,12,0"
                    CornerRadius="4"
                    Background="{DynamicResource Theme.Surface.Secondary}"
                    BorderBrush="{DynamicResource Theme.Border.Subtle}"
                    BorderThickness="1">
                <TextBlock x:Name="GlyphTextBlock"
                           Text="⏳"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="TitleTextBlock"
                       Grid.Row="0"
                       Grid.Column="1"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="BodyTextBlock"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="2"
                         Grid.ColumnSpan="2"
                         Height="6"
                         Margin="0,14,0,0"
                         Minimum="0"
                         Maximum="1"
                         Value="0.5" />
            <TextBlock x:Name="PhaseTextBlock"
                       Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource Theme.FontSize.Caption}" />
        </Grid>
    </Border>
</Window>
