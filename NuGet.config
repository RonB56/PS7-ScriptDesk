<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="PS7ScriptDeskPrivate" value=".private-nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="PS7ScriptDeskPrivate">
      <package pattern="PS7ScriptDesk.PrivateAvalonEdit" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
